---
// 生成式热力星图：贡献热力图 → 星尘。每次访问随机种子点亮一组，缓慢呼吸；
// prefers-reduced-motion 时只画一帧。
---
<div>
  <canvas id="starmap" width="264" height="264" aria-label="生成式热力星图，每次访问随机点亮"></canvas>
  <p class="starmap-cap">no. <span id="seed">——</span></p>
</div>

<script>
  function rng(s: number) {
    return function () {
      s |= 0; s = (s + 0x6d2b79f5) | 0;
      let t = Math.imul(s ^ (s >>> 15), 1 | s);
      t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
      return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
    };
  }

  const cv = document.getElementById('starmap') as HTMLCanvasElement;
  const ctx = cv.getContext('2d')!;
  const seed = Math.floor(Math.random() * 9000) + 1000;
  (document.getElementById('seed') as HTMLElement).textContent = String(seed);

  const cs = getComputedStyle(document.documentElement);
  const accent = cs.getPropertyValue('--accent').trim();
  const faint = cs.getPropertyValue('--faint').trim();
  const dim = cs.getPropertyValue('--dim').trim();

  const N = 9, cell = cv.width / (N + 1), pad = cell / 2;
  const rand = rng(seed);
  const stars: { x: number; y: number; s: number; big: boolean; ph: number; sp: number }[] = [];
  for (let gx = 0; gx < N; gx++) {
    for (let gy = 0; gy < N; gy++) {
      if (rand() < 0.62) continue; // 随机留白 → 每次不一样
      const r = rand();
      stars.push({
        x: pad + (gx + 0.5) * cell,
        y: pad + (gy + 0.5) * cell,
        s: r < 0.16 ? 3.4 : r < 0.5 ? 2.2 : 1.3,
        big: r < 0.16,
        ph: rand() * Math.PI * 2,
        sp: 0.4 + rand() * 0.6,
      });
    }
  }

  const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;

  function draw(t: number) {
    ctx.clearRect(0, 0, cv.width, cv.height);
    for (const st of stars) {
      const breathe = reduced ? 1 : 0.55 + 0.45 * Math.sin((t / 1000) * st.sp + st.ph);
      ctx.globalAlpha = st.big ? breathe : breathe * 0.7;
      ctx.fillStyle = st.big ? accent : st.s > 2 ? dim : faint;
      ctx.beginPath();
      ctx.arc(st.x, st.y, st.s, 0, Math.PI * 2);
      ctx.fill();
    }
    ctx.globalAlpha = 1;
  }

  draw(0); // 先画一帧，避免空白
  if (!reduced) {
    let raf = 0;
    const loop = (t: number) => {
      draw(t);
      raf = requestAnimationFrame(loop);
    };
    // 滚出视口就暂停动画，省电
    const io = new IntersectionObserver((entries) => {
      const visible = entries.some((e) => e.isIntersecting);
      if (visible && !raf) raf = requestAnimationFrame(loop);
      else if (!visible && raf) {
        cancelAnimationFrame(raf);
        raf = 0;
      }
    });
    io.observe(cv);
  }
</script>
