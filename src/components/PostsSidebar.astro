---
// 文章分类侧栏：全部 + 各文件夹，计数右对齐，当前项高亮。首页与分类页共用。
import { categoryLabel, groupByCategory, type Post } from '../lib/categories';

interface Props {
  active: string; // 'all' 或分类 key
  posts: Post[];
}

const { active, posts } = Astro.props;
const groups = groupByCategory(posts);
---

<aside class="posts-side">
  <div class="side-panel">
    <p class="side-cap">分类</p>
    <nav aria-label="文章分类">
      <ul class="side-list">
        <li>
          <a href="/" aria-current={active === 'all' ? 'page' : undefined}>
            全部<span class="n">{posts.length}</span>
          </a>
        </li>
        {[...groups.entries()].map(([key, ps]) => (
          <li>
            <a href={`/cat/${key}/`} aria-current={active === key ? 'page' : undefined}>
              {categoryLabel(key)}<span class="n">{ps.length}</span>
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</aside>

<style>
  .posts-side {
    position: sticky;
    top: 1.5rem;
    font-family: var(--mono);
    font-size: 14px;
  }
  .side-cap {
    font-size: 12px;
    letter-spacing: .18em;
    text-transform: uppercase;
    color: var(--faint);
    margin: 0 0 .7rem;
  }
  .side-list { list-style: none; margin: 0; padding: 0; }
  .side-list li { margin: .35rem 0; }
  .side-list a {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: .8rem;
    color: var(--ink);
    opacity: .68;
    transition: color var(--dur-fast) var(--ease), opacity var(--dur-fast) var(--ease);
  }
  .side-list a:hover { color: var(--accent); opacity: 1; }
  .side-list a[aria-current="page"] { color: var(--ink); opacity: 1; font-weight: 600; }
  .side-list a[aria-current="page"]::before { content: "· "; color: var(--accent); }
  .side-list .n { color: var(--faint); font-size: 12px; }

  /* 移动端：竖排侧栏改为横向滚动胶囊条，分类导航不缺席 */
  @media (max-width: 1100px) {
    .posts-side { position: static; margin-bottom: 1.25rem; }
    .side-cap { display: none; }
    .side-list {
      display: flex;
      gap: .5rem;
      overflow-x: auto;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none;
      padding-bottom: .15rem;
    }
    .side-list::-webkit-scrollbar { display: none; }
    .side-list li { margin: 0; flex-shrink: 0; }
    .side-list a {
      border: 1px solid var(--rule);
      border-radius: 99px;
      padding: .45rem 1rem;
      white-space: nowrap;
    }
    .side-list a[aria-current="page"] { color: var(--accent); border-color: var(--accent); }
    .side-list a[aria-current="page"]::before { content: none; }
  }

  /* 桌面：面板样式在 .side-panel 上（宽屏时 .posts-side 退化为隐形轨道） */
  @media (min-width: 1100px) {
    .side-panel {
      border: 1px solid var(--rule);
      border-radius: 8px;
      padding: .9rem 1.1rem;
    }
  }

  /* 宽屏：侧栏放进铺满内容列的隐形轨道（absolute），面板在轨道内 sticky——
     跟随页面滚动、到顶吸附（与日报目录一致的手感），左缘对齐视口 1.5rem */
  @media (min-width: 1520px) {
    .posts-side {
      position: absolute;
      inset: 0 auto 0 calc(28rem - 50vw); /* 面板左缘对齐视口 1.5rem（基准是 wrap 内容盒） */
      width: 11.5rem;
    }
    .side-panel {
      position: sticky;
      top: 6.5rem; /* 顶部导航条约占 0~75px，避开 */
    }
  }
</style>
