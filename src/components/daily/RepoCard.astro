---
import LangDot from './LangDot.astro';
import { safeUrl, fmtStars, type Repo } from './utils';

interface Props { repo: Repo }
const { repo } = Astro.props;

const url = safeUrl(repo.url);
const growth = +repo.growth > 0 ? `+${+repo.growth}/日` : +repo.weekly_growth > 0 ? `+${+repo.weekly_growth}/周` : '';
---

<article class="card">
  <div class="card-top">
    {url
      ? <a href={url} target="_blank" rel="noopener noreferrer"><span class="rname">{repo.name}</span></a>
      : <span class="rname">{repo.name}</span>}
    <span class="stars">⭐ {fmtStars(repo.stars)}</span>
  </div>
  {repo.description && <p class="desc">{repo.description}</p>}
  <div class="meta">
    <LangDot language={repo.language} />
    {growth && <span class="chip chip-grow">{growth}</span>}
    {repo.source && <span class="chip chip-muted">{repo.source}</span>}
    {repo.created && <span class="chip chip-muted">{repo.created}</span>}
  </div>
</article>

<style>
  .card {
    border: 1px solid var(--rule);
    border-radius: 10px;
    padding: .8rem .9rem;
    display: flex;
    flex-direction: column;
    gap: .4rem;
    min-width: 0;
    transition: border-color var(--dur-fast) var(--ease), transform var(--dur-fast) var(--ease);
  }
  .card:hover { border-color: var(--accent); transform: translateY(-1px); }
  .card-top { display: flex; align-items: center; gap: .5rem; min-width: 0; }
  .card a { color: var(--ink); text-decoration: none; }
  .card a:hover .rname { color: var(--accent); }
  .rname {
    font-family: var(--mono);
    font-size: .9rem;
    font-weight: 600;
    overflow-wrap: anywhere;
    flex: 1;
    min-width: 0;
  }
  .stars {
    font-family: var(--mono);
    font-size: 12px;
    color: var(--dim);
    flex-shrink: 0;
  }
  .desc {
    margin: 0;
    color: var(--dim);
    font-size: .88rem;
    line-height: 1.55;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .meta { display: flex; flex-wrap: wrap; gap: .4rem; margin-top: .1rem; align-items: center; }
  .chip {
    font-family: var(--mono);
    font-size: 11px;
    color: var(--dim);
    background: var(--code-bg);
    border-radius: 999px;
    padding: .12rem .5rem;
  }
  .chip-grow { color: var(--accent); background: var(--accent-soft); }
  .chip-muted { color: var(--dim); } /* faint 在 code-bg 上对比不足 4.5:1 */
</style>
