---
import { langColor } from './utils';

interface Props { language?: string }
const { language } = Astro.props;
const color = langColor(language);
---

{language && (
  <span class="lang">
    <i class="dot" style={color ? `background:${color}` : undefined}></i>{language}
  </span>
)}

<style>
  .lang {
    font-family: var(--mono);
    font-size: 11.5px;
    color: var(--dim);
    display: inline-flex;
    align-items: center;
    gap: .38rem;
    white-space: nowrap;
  }
  .dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--faint);
    flex-shrink: 0;
  }
</style>
