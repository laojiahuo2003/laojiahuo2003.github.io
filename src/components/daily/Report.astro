---
// 单期日报正文：左侧粘性目录 + 右侧内容（头版头条 + 飙升榜 + 分区卡片流）。
// 分区清单由 buildSections 统一给出，目录与正文锚点同源。
// 由 daily/index.astro（最新一期）与 daily/[date].astro（往期）共用。
import Board from './Board.astro';
import RepoCard from './RepoCard.astro';
import LangDot from './LangDot.astro';
import { buildSections, safeUrl, fmtStars, cleanCat, type Repo, type Report as ReportData } from './utils';

interface Props { report: ReportData }
const { report: r } = Astro.props;

const sections = buildSections(r);
const gridSections = sections.filter((s) => s.projects?.length);

// 目录树：独立板块（group 与 title 相同）挂一级，成组板块收进分组
interface TocNode { id?: string; title: string; children?: { id: string; title: string }[] }
const toc: TocNode[] = [];
for (const s of sections) {
  if (!s.group || s.group === s.title) {
    toc.push({ id: s.id, title: s.title });
  } else {
    let g = toc.find((t) => t.children && t.title === s.group);
    if (!g) {
      g = { title: s.group, children: [] };
      toc.push(g);
    }
    // 目录里去掉 "Topic: " 冗余前缀，长英文标签交给 CSS 省略号处理，不折行
    g.children!.push({ id: s.id, title: s.title.replace(/^Topic:\s*/, '') });
  }
}

const heroUrl = r.best ? safeUrl(r.best.url) : '';
const heroTail = r.best
  ? [cleanCat(r.best.category), r.best.created && `创建于 ${r.best.created}`].filter(Boolean).join(' · ')
  : '';
---

<div class="daily-layout">
  <aside class="daily-toc">
    <details class="toc-box" open>
      <summary>本期目录</summary>
      <nav aria-label="本期日报目录">
        <ul class="toc-list">
        {toc.map((t) => (
          <li class={t.children ? 'toc-group' : 'toc-item'}>
            {t.children ? (
              <>
                <span class="toc-group-name">{t.title}</span>
                <ul>
                  {t.children.map((c) => (
                    <li class="toc-item toc-sub"><a href={`#${c.id}`} title={c.title}>{c.title}</a></li>
                  ))}
                </ul>
              </>
            ) : (
              <a href={`#${t.id}`}>{t.title}</a>
            )}
          </li>
        ))}
        </ul>
      </nav>
    </details>
  </aside>

  <div class="daily-body">
    {
      r.best && (
        <div class="hero" id="best">
          <p class="hero-kicker">今日最佳</p>
          <h2 class="hero-name">
            {heroUrl
              ? <a href={heroUrl} target="_blank" rel="noopener noreferrer"><span class="rname">{r.best!.name}</span></a>
              : <span class="rname">{r.best!.name}</span>}
          </h2>
          {r.best.description && <p class="hero-desc">{r.best.description}</p>}
          <div class="hero-foot">
            <div class="hero-stats">
              <span class="hstat"><b>{fmtStars(r.best.stars)}</b>总星标</span>
              {+r.best.growth! > 0 && <span class="hstat hstat-grow"><b>+{r.best.growth}</b>今日增长</span>}
              {heroTail && <span class="hstat hstat-quiet">{heroTail}</span>}
            </div>
            <LangDot language={r.best.language} />
          </div>
        </div>
      )
    }

    {
      r.leaderboard?.length && (
        <section id="board">
          <h2 class="sec"><span class="sec-name">今日飙升榜</span><span class="sec-count">{r.leaderboard.length}</span><span class="sec-rule" /></h2>
          <Board projects={r.leaderboard} />
        </section>
      )
    }

    {gridSections.map((s) => (
      <section id={s.id}>
        <h2 class="sec"><span class="sec-name">{s.heading}</span><span class="sec-count">{s.count}</span><span class="sec-rule" /></h2>
        <div class="grid">{s.projects!.map((p: Repo) => <RepoCard repo={p} />)}</div>
      </section>
    ))}

    {!sections.length && <p class="empty">本期暂无数据。</p>}
  </div>
</div>

<script>
  // 窄屏目录默认收起（展开会把正文推出首屏），与文章页目录同策略
  const tocBox = document.querySelector('.daily-toc details');
  if (tocBox && matchMedia('(max-width: 1100px)').matches) {
    tocBox.removeAttribute('open');
  }

  // 目录滚动高亮：标记当前可见分区（与文章页目录同款逻辑）
  (function () {
    const links = Array.from(document.querySelectorAll<HTMLAnchorElement>('.daily-toc a[href^="#"]'));
    if (!links.length) return;
    const entries: { el: Element; a: HTMLAnchorElement }[] = [];
    for (const a of links) {
      const el = document.getElementById(decodeURIComponent(a.hash.slice(1)));
      if (el) entries.push({ el, a });
    }
    if (!entries.length) return;

    let ticking = false;
    function update() {
      ticking = false;
      let active = entries[0].a;
      for (const { el, a } of entries) {
        if (el.getBoundingClientRect().top <= 140) active = a;
      }
      for (const { a } of entries) a.classList.toggle('active', a === active);
    }
    window.addEventListener('scroll', () => {
      if (!ticking) { ticking = true; requestAnimationFrame(update); }
    }, { passive: true });
    update();
  })();
</script>

<style>
  /* ---- 双栏布局：粘性目录 + 正文 ---- */
  .daily-layout {
    display: grid;
    grid-template-columns: 13rem minmax(0, 1fr);
    gap: 4.5rem;
    align-items: start;
  }
  .daily-toc {
    position: sticky;
    top: 1.5rem;
    max-height: calc(100vh - 3rem);
    overflow-y: auto;
    font-family: var(--mono);
    font-size: 14px;
    /* 目录超长出现滚动条时，用主题色细条，避免 Windows 默认的白色粗滚动条 */
    scrollbar-width: thin;
    scrollbar-color: var(--rule) transparent;
  }
  .daily-toc::-webkit-scrollbar { width: 4px; }
  .daily-toc::-webkit-scrollbar-thumb { background: var(--rule); border-radius: 2px; }
  .daily-toc::-webkit-scrollbar-track { background: transparent; }
  .toc-box summary {
    font-family: var(--mono);
    font-size: 12px;
    letter-spacing: .18em;
    text-transform: uppercase;
    color: var(--faint);
    margin: 0 0 .7rem;
    cursor: default;
    list-style: none;
    user-select: none;
  }
  .toc-box summary::-webkit-details-marker { display: none; }
  .toc-list { list-style: none; margin: 0; padding: 0; }
  .toc-group-name {
    display: block;
    color: var(--ink);
    font-weight: 600;
    margin: .8rem 0 .35rem;
  }
  .toc-group:first-child .toc-group-name { margin-top: 0; }
  .toc-item { margin: .35rem 0; }
  .toc-item a {
    display: block;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap; /* 长英文标签（如 artificial-intelligence）省略号截断，不折行 */
    padding: .1rem .35rem .1rem .5rem;
    border-left: 2px solid transparent; /* 常驻占位，激活时文字不跳动 */
    border-radius: 0 4px 4px 0;
    color: var(--ink);
    opacity: .68;
    transition: color var(--dur-fast) var(--ease), opacity var(--dur-fast) var(--ease),
                background var(--dur-fast) var(--ease), border-color var(--dur-fast) var(--ease);
  }
  .toc-item a:hover { color: var(--accent); opacity: 1; }
  /* 滚动联动的当前项：绿字加粗 + 左缘绿条 + 淡绿底，离正文再远也一眼可见 */
  .toc-item a.active {
    color: var(--accent);
    opacity: 1;
    font-weight: 600;
    border-left-color: var(--accent);
    background: var(--accent-soft);
  }
  .toc-sub { padding-left: .85rem; }

  /* 窄屏：目录改为可折叠块，不再整体隐藏（长页面需要导航入口） */
  @media (max-width: 1100px) {
    .daily-layout { grid-template-columns: minmax(0, 1fr); }
    .daily-toc {
      position: static;
      max-height: none;
      overflow: visible;
      font-size: 14px;
      margin-bottom: 1.4rem;
    }
    .toc-box summary {
      cursor: pointer;
      display: flex;
      align-items: center;
      font-size: 13px;
      letter-spacing: .08em;
      text-transform: none;
      color: var(--dim);
      border: 1px solid var(--rule);
      border-radius: 8px;
      padding: .6rem .95rem;
      margin: 0;
      transition: color var(--dur-fast) var(--ease), border-color var(--dur-fast) var(--ease);
    }
    .toc-box summary::after {
      content: "▾";
      margin-left: auto;
      color: var(--faint);
      transition: transform var(--dur-fast) var(--ease);
    }
    .toc-box[open] summary { color: var(--accent); border-color: var(--accent); }
    .toc-box[open] summary::after { transform: rotate(180deg); }
    .toc-box[open] .toc-list { margin-top: .8rem; }
    .toc-sub { padding-left: 1rem; }
  }

  /* 桌面：目录加面板样式，与文章页目录一致 */
  @media (min-width: 1100px) {
    .daily-toc {
      border: 1px solid var(--rule);
      border-radius: 8px;
      padding: .9rem 1.1rem;
    }
  }

  /* 宽屏：子导航固定在视口最左缘，位置恒定不随窗口宽度移动（内容列已右移，间距始终宽裕） */
  @media (min-width: 1520px) {
    .daily-layout { display: block; }
    .daily-toc {
      position: fixed;
      left: max(1.5rem, env(safe-area-inset-left));
      top: 6.5rem;
      width: 11.5rem;
      max-height: calc(100vh - 10rem);
    }
  }

  /* ---- 分区标题：衬线大标题 + 色块记号，比旧版 eyebrow 小字醒目 ---- */
  .sec {
    display: flex;
    align-items: center;
    gap: .7rem;
    margin: 2.6rem 0 1.05rem;
    scroll-margin-top: 1.5rem;
  }
  .sec-name {
    font-family: var(--serif);
    font-weight: 600;
    font-size: 1.16rem;
    line-height: 1.35;
    letter-spacing: .01em;
    color: var(--ink);
  }
  .sec-name::before {
    content: "";
    display: inline-block;
    width: .5rem;
    height: .5rem;
    border-radius: 2px;
    background: var(--accent);
    margin-right: .55rem;
    vertical-align: .14em;
  }
  .sec-count {
    font-family: var(--mono);
    font-size: 11.5px;
    font-weight: 500;
    color: var(--accent);
    background: var(--accent-soft);
    border-radius: 999px;
    padding: .12rem .6rem;
  }
  .sec-rule { flex: 1; height: 1px; background: var(--rule); }

  /* ---- 头版头条 ---- */
  .hero {
    border: 1px solid var(--rule);
    border-left: 3px solid var(--accent);
    border-radius: 12px;
    padding: 1.4rem 1.6rem 1.3rem;
    background: var(--accent-soft);
    scroll-margin-top: 1.5rem;
  }
  .hero-kicker {
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: .22em;
    text-transform: uppercase;
    color: var(--accent);
    margin: 0 0 .55rem;
  }
  .hero-name { font-size: 1.3rem; margin: 0 0 .5rem; }
  .hero-name a { color: var(--ink); text-decoration: none; }
  .hero-name a:hover { color: var(--accent); }
  .hero-name .rname {
    font-family: var(--mono);
    font-size: 1.15rem;
    overflow-wrap: anywhere;
  }
  .hero-desc {
    color: var(--dim);
    margin: 0 0 1.1rem;
    line-height: 1.65;
    font-size: .95rem;
    max-width: 62ch;
  }
  .hero-foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: .8rem;
  }
  .hero-stats { display: flex; flex-wrap: wrap; gap: 1.4rem; align-items: baseline; }
  .hstat {
    font-family: var(--mono);
    font-size: 11.5px;
    color: var(--faint);
    display: inline-flex;
    align-items: baseline;
    gap: .45rem;
  }
  .hstat b {
    font-size: 1.45rem;
    font-weight: 600;
    color: var(--ink);
    letter-spacing: .01em;
  }
  .hstat-grow b { color: var(--accent); }
  .hstat-quiet { font-size: 11.5px; }

  .grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: .8rem;
  }
  .empty { color: var(--dim); }

  @media (max-width: 720px) {
    .grid { grid-template-columns: 1fr; }
  }
</style>
