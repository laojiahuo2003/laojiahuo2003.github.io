---
// 单期日报正文：头版头条 hero + 飙升榜 + 各分区卡片流。
// 由 daily/index.astro（最新一期）与 daily/[date].astro（往期）共用。
import Board from './Board.astro';
import RepoCard from './RepoCard.astro';
import LangDot from './LangDot.astro';
import { safeUrl, fmtStars, cleanCat, type Repo, type Report as ReportData } from './utils';

interface Props { report: ReportData }
const { report: r } = Astro.props;

const heroUrl = r.best ? safeUrl(r.best.url) : '';
const heroTail = r.best
  ? [cleanCat(r.best.category), r.best.created && `创建于 ${r.best.created}`].filter(Boolean).join(' · ')
  : '';

// 分区定义：标题 + 项目列表，渲染为 eyebrow 标题 + 卡片网格
const sections: { title: string; projects: Repo[] }[] = [];
if (r.fast_growing?.length) sections.push({ title: '快速增长项目', projects: r.fast_growing });
if (r.monthly?.length) sections.push({ title: '本月新星', projects: r.monthly });
(r.by_category ?? []).forEach((g) => {
  if (g.projects.length) sections.push({ title: cleanCat(g.category), projects: g.projects });
});
(r.new_projects ?? []).forEach((g) => {
  if (g.projects.length) sections.push({ title: `新项目 · ${cleanCat(g.category)}`, projects: g.projects });
});
(r.explored ?? []).forEach((g) => {
  if (g.projects.length) sections.push({ title: `深度探索 · ${g.strategy}`, projects: g.projects });
});
if (r.newly_discovered?.length) sections.push({ title: '新发现项目', projects: r.newly_discovered });
---

{
  r.best && (
    <div class="hero">
      <p class="hero-kicker">今日最佳</p>
      <h2 class="hero-name">
        {heroUrl
          ? <a href={heroUrl} target="_blank" rel="noopener noreferrer"><span class="rname">{r.best!.name}</span></a>
          : <span class="rname">{r.best!.name}</span>}
      </h2>
      {r.best.description && <p class="hero-desc">{r.best.description}</p>}
      <div class="hero-foot">
        <div class="hero-stats">
          <span class="hstat"><b>{fmtStars(r.best.stars)}</b>总星标</span>
          {+r.best.growth! > 0 && <span class="hstat hstat-grow"><b>+{r.best.growth}</b>今日增长</span>}
          {heroTail && <span class="hstat hstat-quiet">{heroTail}</span>}
        </div>
        <LangDot language={r.best.language} />
      </div>
    </div>
  )
}

{
  r.leaderboard?.length && (
    <>
      <h2 class="sec"><span class="sec-name">今日飙升榜</span><span class="sec-count">{r.leaderboard.length}</span><span class="sec-rule" /></h2>
      <Board projects={r.leaderboard} />
    </>
  )
}

{sections.map((s) => (
  <>
    <h2 class="sec"><span class="sec-name">{s.title}</span><span class="sec-count">{s.projects.length}</span><span class="sec-rule" /></h2>
    <div class="grid">{s.projects.map((p) => <RepoCard repo={p} />)}</div>
  </>
))}

{!r.best && !sections.length && !r.leaderboard?.length && <p class="empty">本期暂无数据。</p>}

<style>
  /* ---- 分区标题：eyebrow 风格 + 延伸细线 ---- */
  .sec {
    display: flex;
    align-items: center;
    gap: .6rem;
    margin: 2.4rem 0 1rem;
  }
  .sec-name {
    font-family: var(--mono);
    font-size: 12px;
    font-weight: 600;
    letter-spacing: .18em;
    text-transform: uppercase;
    color: var(--ink);
  }
  .sec-count {
    font-family: var(--mono);
    font-size: 11px;
    font-weight: 500;
    color: var(--accent);
    background: var(--accent-soft);
    border-radius: 999px;
    padding: .1rem .55rem;
  }
  .sec-rule { flex: 1; height: 1px; background: var(--rule); }

  /* ---- 头版头条 ---- */
  .hero {
    border: 1px solid var(--rule);
    border-left: 3px solid var(--accent);
    border-radius: 12px;
    padding: 1.4rem 1.6rem 1.3rem;
    background: var(--accent-soft);
  }
  .hero-kicker {
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: .22em;
    text-transform: uppercase;
    color: var(--accent);
    margin: 0 0 .55rem;
  }
  .hero-name { font-size: 1.3rem; margin: 0 0 .5rem; }
  .hero-name a { color: var(--ink); text-decoration: none; }
  .hero-name a:hover { color: var(--accent); }
  .hero-name .rname {
    font-family: var(--mono);
    font-size: 1.15rem;
    overflow-wrap: anywhere;
  }
  .hero-desc {
    color: var(--dim);
    margin: 0 0 1.1rem;
    line-height: 1.65;
    font-size: .95rem;
    max-width: 62ch;
  }
  .hero-foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: .8rem;
  }
  .hero-stats { display: flex; flex-wrap: wrap; gap: 1.4rem; align-items: baseline; }
  .hstat {
    font-family: var(--mono);
    font-size: 11.5px;
    color: var(--faint);
    display: inline-flex;
    align-items: baseline;
    gap: .45rem;
  }
  .hstat b {
    font-size: 1.45rem;
    font-weight: 600;
    color: var(--ink);
    letter-spacing: .01em;
  }
  .hstat-grow b { color: var(--accent); }
  .hstat-quiet { font-size: 11.5px; }

  .grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: .8rem;
  }
  .empty { color: var(--dim); }

  @media (max-width: 720px) {
    .grid { grid-template-columns: 1fr; }
  }
</style>
