---
// 期刊式报头：衬线大字日期
import { fmtDate, type Report } from './utils';

interface Props { report: Report }
const { report } = Astro.props;
---

<header class="masthead">
  <h1 class="masthead-date">{fmtDate(report.date)}</h1>
</header>

<style>
  .masthead { margin-bottom: 2.75rem; }
  .masthead-date {
    font-family: var(--serif);
    font-weight: 600;
    font-size: 2.15rem;
    line-height: 1.2;
    letter-spacing: .01em;
    margin: 0;
    text-wrap: balance;
  }

  @media (max-width: 720px) {
    .masthead-date { font-size: 1.7rem; }
  }
</style>
