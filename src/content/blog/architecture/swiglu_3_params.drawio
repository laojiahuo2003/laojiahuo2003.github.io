<mxfile host="app.diagrams.net"><diagram id="d66" name="3 · 参数账"><mxGraphModel dx="900" dy="700" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1000" pageHeight="520"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n47" value="多一个矩阵，宽度缩到 2/3 找平" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;arcSize=8;strokeColor=#FFFFFF;strokeWidth=1.2;fontStyle=1;fontSize=15;fontColor=#1A2332" vertex="1" parent="1"><mxGeometry x="40" y="18" width="920" height="34" as="geometry"/></mxCell><mxCell id="n48" value="W₁&#xa;4096&#xa;×16384" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1BEE7;arcSize=8;strokeColor=#5A6B7F;strokeWidth=1.2;fontSize=11;fontColor=#1A2332" vertex="1" parent="1"><mxGeometry x="90" y="110" width="90" height="200" as="geometry"/></mxCell><mxCell id="n49" value="W₂&#xa;16384&#xa;×4096" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1BEE7;arcSize=8;strokeColor=#5A6B7F;strokeWidth=1.2;fontSize=11;fontColor=#1A2332" vertex="1" parent="1"><mxGeometry x="200" y="110" width="90" height="200" as="geometry"/></mxCell><mxCell id="n50" value="老 FFN：2 × 4096 × 16384 = 134.2 M" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;arcSize=8;strokeColor=#FFFFFF;strokeWidth=1.2;fontSize=11;fontColor=#1A2332" vertex="1" parent="1"><mxGeometry x="80" y="80" width="230" height="24" as="geometry"/></mxCell><mxCell id="n51" value="W_gate&#xa;4096&#xa;×11008" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#C8E6C9;arcSize=8;strokeColor=#5A6B7F;strokeWidth=1.2;fontSize=10;fontColor=#1A2332" vertex="1" parent="1"><mxGeometry x="500" y="176.66666666666666" width="90" height="133.33333333333334" as="geometry"/></mxCell><mxCell id="n52" value="W_up&#xa;4096&#xa;×11008" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#C8E6C9;arcSize=8;strokeColor=#5A6B7F;strokeWidth=1.2;fontSize=10;fontColor=#1A2332" vertex="1" parent="1"><mxGeometry x="610" y="176.66666666666666" width="90" height="133.33333333333334" as="geometry"/></mxCell><mxCell id="n53" value="W_down&#xa;11008&#xa;×4096" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#C8E6C9;arcSize=8;strokeColor=#5A6B7F;strokeWidth=1.2;fontSize=10;fontColor=#1A2332" vertex="1" parent="1"><mxGeometry x="720" y="176.66666666666666" width="90" height="133.33333333333334" as="geometry"/></mxCell><mxCell id="n54" value="SwiGLU：3 × 4096 × 11008 = 135.3 M（+0.8%）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;arcSize=8;strokeColor=#FFFFFF;strokeWidth=1.2;fontSize=11;fontColor=#1A2332" vertex="1" parent="1"><mxGeometry x="490" y="80" width="330" height="24" as="geometry"/></mxCell><mxCell id="n55" value="找平公式：3 × d × (2/3 · d_ff) = 2 × d × d_ff　→　中间宽度 = 原宽度 × 2/3&#xa;Llama2-7B 实算：4096 × 4 = 16384 → × 2/3 = 10922.7 → 向上取整到 256 倍数 = 11008" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFDE7;arcSize=8;strokeColor=#5A6B7F;strokeWidth=1.2;fontSize=12;fontColor=#1A2332" vertex="1" parent="1"><mxGeometry x="141.45999999999998" y="370" width="717.08" height="58.400000000000006" as="geometry"/></mxCell><mxCell id="n56" value="config 里那行 intermediate_size: 11008 —— 不是玄学，是一道四则运算" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8E1;arcSize=8;strokeColor=#5A6B7F;strokeWidth=1.2;fontSize=11;fontColor=#1A2332" vertex="1" parent="1"><mxGeometry x="229.42000000000002" y="448" width="541.16" height="34.35" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>