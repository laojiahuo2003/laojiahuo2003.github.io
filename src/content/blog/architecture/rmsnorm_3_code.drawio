<mxfile host="app.diagrams.net"><diagram id="d59" name="3 · 公式与代码对照"><mxGraphModel dx="900" dy="700" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="900" pageHeight="700"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n42" value="一行公式，两行代码" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;arcSize=8;strokeColor=#FFFFFF;strokeWidth=1.2;fontStyle=1;fontSize=15;fontColor=#1A2332" vertex="1" parent="1"><mxGeometry x="60" y="24" width="780" height="36" as="geometry"/></mxCell><mxCell id="n43" value="y_i = γ_i · x_i / sqrt( (1/d)·Σ_j x_j² + ε )" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFDE7;arcSize=8;strokeColor=#5A6B7F;strokeWidth=1.2;fontStyle=1;fontSize=14;fontColor=#1A2332" vertex="1" parent="1"><mxGeometry x="60" y="84" width="780" height="52" as="geometry"/></mxCell><mxCell id="n44" value="class RMSNorm(nn.Module):&#xa;    def __init__(self, dim, eps=1e-5):&#xa;        self.eps = eps&#xa;        self.weight = nn.Parameter(torch.ones(dim))   # γ&#xa;&#xa;    def forward(self, x):                            # x: (B,S,d)&#xa;        return x * torch.rsqrt(                      # ②÷√(ms+ε)&#xa;            x.pow(2).mean(-1, keepdim=True) + self.eps)  # ①ms=mean(x²)&#xa;               ) * self.weight                       # ③×γ" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F7FA;arcSize=8;strokeColor=#5A6B7F;strokeWidth=1.2;fontSize=12;fontColor=#1A2332" vertex="1" parent="1"><mxGeometry x="105.32" y="160" width="689.36" height="207.6" as="geometry"/></mxCell><mxCell id="n45" value="归一化在子层【前】&#xa;&#xa;x = x + Attn(Norm(x))&#xa;x = x + FFN(Norm(x))" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#C8E6C9;arcSize=8;strokeColor=#5A6B7F;strokeWidth=1.2;fontSize=11;fontColor=#1A2332" vertex="1" parent="1"><mxGeometry x="60.0" y="420" width="235" height="170" as="geometry"/></mxCell><mxCell id="n46" value="pre-norm 放置" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE0B2;arcSize=8;strokeColor=#5A6B7F;strokeWidth=1.2;fontStyle=1;fontSize=12;fontColor=#1A2332" vertex="1" parent="1"><mxGeometry x="60.0" y="392" width="235" height="26" as="geometry"/></mxCell><mxCell id="n47" value="Llama-2-7B: d=4096, ε=1e-5&#xa;Qwen3: d=4096, ε=1e-6&#xa;DeepSeek-V3: d=7168, ε=1e-6" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;arcSize=8;strokeColor=#5A6B7F;strokeWidth=1.2;fontSize=11;fontColor=#1A2332" vertex="1" parent="1"><mxGeometry x="332.5" y="420" width="235" height="170" as="geometry"/></mxCell><mxCell id="n48" value="真实超参" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE0B2;arcSize=8;strokeColor=#5A6B7F;strokeWidth=1.2;fontStyle=1;fontSize=12;fontColor=#1A2332" vertex="1" parent="1"><mxGeometry x="332.5" y="392" width="235" height="26" as="geometry"/></mxCell><mxCell id="n49" value="β 的自由度在大规模下&#xa;收益≈0，且是量化时&#xa;激活异常的惯犯" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8E1;arcSize=8;strokeColor=#5A6B7F;strokeWidth=1.2;fontSize=11;fontColor=#1A2332" vertex="1" parent="1"><mxGeometry x="605.0" y="420" width="235" height="170" as="geometry"/></mxCell><mxCell id="n50" value="敢去掉 β 的理由" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE0B2;arcSize=8;strokeColor=#5A6B7F;strokeWidth=1.2;fontStyle=1;fontSize=12;fontColor=#1A2332" vertex="1" parent="1"><mxGeometry x="605.0" y="392" width="235" height="26" as="geometry"/></mxCell><mxCell id="n51" value="最后一层后还有一个 final RMSNorm 再接 lm_head——手写时最容易漏" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF9C4;arcSize=8;strokeColor=#5A6B7F;strokeWidth=1.2;fontSize=11.5;fontColor=#1A2332" vertex="1" parent="1"><mxGeometry x="60" y="620" width="780" height="40" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>