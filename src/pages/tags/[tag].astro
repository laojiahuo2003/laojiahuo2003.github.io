---
// 分类页：/tags/<tag>/，分类即标签（frontmatter tags），与左侧侧栏一致。
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PostsSidebar from '../../components/PostsSidebar.astro';
import PostList from '../../components/PostList.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  const tags = new Map<string, typeof posts>();
  for (const post of posts) {
    for (const t of post.data.tags) {
      if (!tags.has(t)) tags.set(t, []);
      tags.get(t)!.push(post);
    }
  }
  return [...tags.entries()].map(([tag, tagged]) => ({
    params: { tag },
    props: { tagged },
  }));
}

const { tag } = Astro.params;
const { tagged } = Astro.props;
const allPosts = await getCollection('blog');
---

<Base title={`${tag} · Jiahuo Lao 的手记`} description={`分类「${tag}」下的全部文章`}>
  <div class="posts-layout">
    <PostsSidebar active={tag!} posts={allPosts} />
    <div class="posts-main">
      <header class="cat-header">
        <p class="eyebrow">分类</p>
        <h1>{tag}</h1>
        <p class="article-meta">{tagged.length} 篇</p>
      </header>
      <PostList posts={tagged} />
    </div>
  </div>
</Base>

<style>
  .cat-header { margin: 0 0 2rem; }
  .cat-header h1 {
    font-family: var(--serif);
    font-weight: 600;
    font-size: 1.7rem;
    line-height: 1.3;
    margin: 0;
    text-wrap: balance;
  }
  .article-meta {
    font-family: var(--mono);
    font-size: 12px;
    color: var(--faint);
    margin: .4rem 0 0;
  }
</style>
