---
import Base from '../layouts/Base.astro';

// 开源日报由 github-daily-report 仓库的 GitHub Actions 每天生成结构化 feed.json，
// 浏览器端读取（jsdelivr CDN 优先，raw 回退），每页一期，按分区渲染成卡片。
const FEED_SOURCES = [
  'https://cdn.jsdelivr.net/gh/laojiahuo2003/github-daily-report@main/feed.json',
  'https://raw.githubusercontent.com/laojiahuo2003/github-daily-report/main/feed.json',
];
const REPO_URL = 'https://github.com/laojiahuo2003/github-daily-report';
---

<Base title="开源日报 · Jiahuo Lao 的手记" description="每日 GitHub 趋势、飙升榜与新项目发现" bodyClass="daily-page">
  <header slot="header" class="home-header">
    <div>
      <p class="eyebrow">GitHub Trending · 每日 09:00 / 18:00 更新</p>
      <h1>开源日报</h1>
      <p class="bio">
        自动追踪 GitHub <em>趋势、飙升榜与新项目</em>，数据来自
        <a href={REPO_URL}>github-daily-report</a> 仓库。
      </p>
    </div>
  </header>

  <section>
    <div id="daily-pager" class="daily-pager">
      <button id="daily-newer" class="daily-nav" type="button" disabled>← 较新</button>
      <span id="daily-indicator" class="daily-indicator">加载中…</span>
      <button id="daily-older" class="daily-nav" type="button" disabled>较旧 →</button>
    </div>

    <article id="daily-view" aria-live="polite"></article>

    <p id="daily-error" hidden>
      加载失败，<a href={REPO_URL}>直接去仓库看报告</a>。
    </p>
  </section>

  <script define:vars={{ FEED_SOURCES }}>
    (function () {
      var view = document.getElementById('daily-view');
      var err = document.getElementById('daily-error');
      var btnNewer = document.getElementById('daily-newer');
      var btnOlder = document.getElementById('daily-older');
      var indicator = document.getElementById('daily-indicator');

      var items = [];
      var idx = 0; // 0 = 最新一期

      // ---------- 安全工具 ----------
      var esc = function (s) {
        return String(s == null ? '' : s)
          .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;')
          .replace(/"/g, '&quot;');
      };
      var safeUrl = function (u) {
        return /^https?:\/\//.test(u || '') ? u : '';
      };
      var fmtStars = function (n) {
        n = +n || 0;
        if (n >= 1000) {
          var s = (n / 1000).toFixed(1);
          if (/\.0$/.test(s)) s = s.slice(0, -2);
          return s + 'k';
        }
        return String(n);
      };
      var fmtDate = function (d) {
        var m = /^(\d{4})-(\d{2})-(\d{2})$/.exec(d || '');
        return m ? (+m[1]) + ' 年 ' + (+m[2]) + ' 月 ' + (+m[3]) + ' 日' : (d || '');
      };

      // ---------- 卡片渲染 ----------
      var repoLink = function (r) {
        var url = safeUrl(r.url);
        var name = '<span class="rname">' + esc(r.name) + '</span>';
        return url
          ? '<a href="' + esc(url) + '" target="_blank" rel="noopener noreferrer">' + name + '</a>'
          : name;
      };

      var repoCard = function (r, opts) {
        opts = opts || {};
        var meta = [];
        if (r.language) meta.push('<span class="chip">' + esc(r.language) + '</span>');
        if (opts.badge) meta.push('<span class="chip chip-grow">' + esc(opts.badge) + '</span>');
        else if (+r.growth > 0) meta.push('<span class="chip chip-grow">+' + (+r.growth) + '/日</span>');
        else if (+r.weekly_growth > 0) meta.push('<span class="chip chip-grow">+' + (+r.weekly_growth) + '/周</span>');
        if (r.source) meta.push('<span class="chip chip-muted">' + esc(r.source) + '</span>');
        if (r.created) meta.push('<span class="chip chip-muted">' + esc(r.created) + '</span>');

        var rank = '';
        if (opts.rank) {
          var top = opts.rank <= 3;
          rank = '<span class="rank' + (top ? ' rank-top' : '') + '">' + opts.rank + '</span>';
        }

        return '<article class="card">' +
          '<div class="card-top">' + rank + repoLink(r) +
            '<span class="stars">⭐ ' + esc(fmtStars(r.stars)) + '</span></div>' +
          (r.description ? '<p class="desc">' + esc(r.description) + '</p>' : '') +
          (meta.length ? '<div class="meta">' + meta.join('') + '</div>' : '') +
          '</article>';
      };

      var sec = function (title, count) {
        return '<h3 class="sec"><span>' + title + '</span>' +
          (count != null ? '<span class="sec-count">' + count + '</span>' : '') +
          '</h3>';
      };

      var grid = function (projects, opts) {
        return '<div class="grid">' +
          projects.map(function (p, i) {
            return repoCard(p, opts && opts.ranked ? Object.assign({ rank: i + 1 }, opts) : opts);
          }).join('') +
          '</div>';
      };

      var heroCard = function (b) {
        var pills = [];
        if (b.stars_fmt || +b.stars) pills.push(['⭐ 总星标', esc(fmtStars(b.stars))]);
        if (+b.growth > 0) pills.push(['🔺 今日增长', '+' + (+b.growth)]);
        if (b.language) pills.push(['💻 语言', esc(b.language)]);
        if (b.category) pills.push(['🗂 分类', esc(b.category)]);
        if (b.created) pills.push(['📅 创建', esc(b.created)]);
        var name = '<span class="rname">' + esc(b.name) + '</span>';
        var url = safeUrl(b.url);
        return '<div class="hero">' +
          '<h2 class="hero-name">' +
            (url ? '<a href="' + esc(url) + '" target="_blank" rel="noopener noreferrer">' + name + '</a>' : name) +
          '</h2>' +
          (b.description ? '<p class="hero-desc">' + esc(b.description) + '</p>' : '') +
          '<div class="pills">' + pills.map(function (p) {
            return '<span class="pill"><b>' + p[0] + '</b>' + p[1] + '</span>';
          }).join('') + '</div>' +
          '</div>';
      };

      var renderReport = function (r) {
        var html = '';
        var total = 0;
        total += r.best ? 1 : 0;
        total += (r.leaderboard || []).length;
        total += (r.fast_growing || []).length;
        total += (r.monthly || []).length;
        (r.by_category || []).forEach(function (g) { total += g.projects.length; });
        (r.new_projects || []).forEach(function (g) { total += g.projects.length; });
        (r.explored || []).forEach(function (g) { total += g.projects.length; });
        total += (r.newly_discovered || []).length;

        if (r.best) {
          html += sec('🏆 今日最佳', null) + heroCard(r.best);
        }
        if ((r.leaderboard || []).length) {
          html += sec('📊 今日飙升榜', r.leaderboard.length) +
            grid(r.leaderboard, { ranked: true });
        }
        if ((r.fast_growing || []).length) {
          html += sec('🚀 快速增长项目', r.fast_growing.length) + grid(r.fast_growing);
        }
        if ((r.monthly || []).length) {
          html += sec('📈 本月新星', r.monthly.length) + grid(r.monthly);
        }
        (r.by_category || []).forEach(function (g) {
          if (g.projects.length) html += sec('🔥 ' + g.category, g.projects.length) + grid(g.projects);
        });
        (r.new_projects || []).forEach(function (g) {
          if (g.projects.length) html += sec('🌱 ' + g.category, g.projects.length) + grid(g.projects);
        });
        (r.explored || []).forEach(function (g) {
          if (g.projects.length) html += sec('🔍 ' + g.strategy, g.projects.length) + grid(g.projects);
        });
        if ((r.newly_discovered || []).length) {
          html += sec('✨ 新发现项目', r.newly_discovered.length) + grid(r.newly_discovered);
        }

        var head = '<div class="report-head">' +
          '<h2 class="report-date">' + esc(fmtDate(r.date)) + '</h2>' +
          '<span class="report-sum">共 ' + total + ' 个项目</span>' +
          '</div>';

        view.innerHTML = head + (html || '<p class="empty">本期暂无数据。</p>');
      };

      var render = function () {
        renderReport(items[idx]);
        indicator.textContent = idx === 0
          ? '最新一期'
          : '第 ' + (idx + 1) + ' / ' + items.length + ' 期';
        btnNewer.disabled = idx === 0;
        btnOlder.disabled = idx >= items.length - 1;
      };

      // ---------- feed 加载 ----------
      // 双源并发：首个成功立即渲染，更新的源到达后再升级。
      // 每个源单独加 6s 超时——raw 在国内常挂起几十秒，绝不能拖慢 jsdelivr 的首屏。
      var parseFeed = function (text) {
        var data = JSON.parse(text);
        if (!data || !Array.isArray(data.reports) || !data.reports.length) throw new Error('empty');
        return data;
      };

      var showError = function () {
        view.hidden = true;
        document.getElementById('daily-pager').hidden = true;
        err.hidden = false;
      };

      var loadFeed = function () {
        var rendered = false;
        var bestUpdated = '';

        var apply = function (data) {
          // 已渲染且新数据不比现有新 → 跳过（避免旧源覆盖新源）
          if (rendered && (data.updated || '') <= bestUpdated) return;
          bestUpdated = data.updated || '';
          items = data.reports.slice(0, 10);
          render();
          rendered = true;
        };

        var jobs = FEED_SOURCES.map(function (url) {
          var ctrl = typeof AbortController !== 'undefined' ? new AbortController() : null;
          var timer = ctrl ? setTimeout(function () { ctrl.abort(); }, 6000) : null;
          return fetch(url, ctrl ? { signal: ctrl.signal } : {})
            .then(function (r) { if (!r.ok) throw new Error(r.status); return r.text(); })
            .then(parseFeed)
            .then(apply)
            .catch(function () {})
            .then(function () { if (timer) clearTimeout(timer); });
        });

        Promise.all(jobs).then(function () {
          if (!rendered) showError();
        });
      };

      loadFeed();

      btnNewer.addEventListener('click', function () {
        if (idx > 0) { idx--; render(); }
      });
      btnOlder.addEventListener('click', function () {
        if (idx < items.length - 1) { idx++; render(); }
      });
    })();
  </script>

  <style is:global>
    /* 日报是卡片流而非正文，比文章页略宽，容纳双栏卡片 */
    body.daily-page .wrap { max-width: 60rem; }
    @media (max-width: 900px) { body.daily-page .wrap { max-width: 42rem; } }
  </style>

  <style>
    .daily-pager {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 1rem;
      margin: 0 0 1.6rem;
    }
    .daily-nav {
      font-family: var(--mono);
      font-size: 12.5px;
      color: var(--dim);
      background: transparent;
      border: 1px solid var(--rule);
      border-radius: 6px;
      padding: .35rem .8rem;
      cursor: pointer;
      transition: color var(--dur-fast) var(--ease), border-color var(--dur-fast) var(--ease);
    }
    .daily-nav:hover:not(:disabled) { color: var(--accent); border-color: var(--accent); }
    .daily-nav:disabled { opacity: .35; cursor: default; }
    .daily-indicator {
      font-family: var(--mono);
      font-size: 12px;
      color: var(--faint);
      letter-spacing: .05em;
    }

    .report-head {
      display: flex;
      align-items: baseline;
      gap: .75rem;
      padding-bottom: .6rem;
      margin-bottom: .4rem;
      border-bottom: 1px solid var(--rule);
    }
    .report-date {
      font-family: var(--mono);
      font-size: 1.05rem;
      font-weight: 600;
      color: var(--ink);
      margin: 0;
      letter-spacing: .02em;
    }
    .report-sum {
      font-family: var(--mono);
      font-size: 12px;
      color: var(--faint);
    }

    .sec {
      display: flex;
      align-items: center;
      gap: .55rem;
      margin: 2.2rem 0 .9rem;
      font-size: 1rem;
      font-weight: 600;
      color: var(--ink);
    }
    .sec-count {
      font-family: var(--mono);
      font-size: 11px;
      font-weight: 500;
      color: var(--faint);
      background: var(--code-bg);
      border-radius: 999px;
      padding: .14rem .55rem;
    }

    .hero {
      border: 1px solid var(--rule);
      border-left: 3px solid var(--accent);
      border-radius: 10px;
      padding: 1.15rem 1.3rem;
      background: var(--accent-soft);
    }
    .hero-name { font-size: 1.15rem; margin: 0 0 .45rem; }
    .hero-name a { color: var(--ink); text-decoration: none; }
    .hero-name a:hover { color: var(--accent); }
    .hero-name .rname { font-family: var(--mono); font-size: 1.05rem; overflow-wrap: anywhere; }
    .hero-desc { color: var(--dim); margin: 0 0 .9rem; line-height: 1.6; font-size: .94rem; }
    .pills { display: flex; flex-wrap: wrap; gap: .5rem; }
    .pill {
      font-family: var(--mono);
      font-size: 12px;
      color: var(--dim);
      background: var(--ground);
      border: 1px solid var(--rule);
      border-radius: 6px;
      padding: .22rem .6rem;
    }
    .pill b { font-weight: 600; color: var(--faint); margin-right: .35rem; }

    .grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: .8rem;
    }
    .card {
      border: 1px solid var(--rule);
      border-radius: 10px;
      padding: .8rem .9rem;
      display: flex;
      flex-direction: column;
      gap: .4rem;
      min-width: 0;
      transition: border-color var(--dur-fast) var(--ease), transform var(--dur-fast) var(--ease);
    }
    .card:hover { border-color: var(--accent); transform: translateY(-1px); }
    .card-top { display: flex; align-items: center; gap: .5rem; min-width: 0; }
    .card a { color: var(--ink); text-decoration: none; }
    .card a:hover .rname { color: var(--accent); }
    .rname {
      font-family: var(--mono);
      font-size: .9rem;
      font-weight: 600;
      overflow-wrap: anywhere;
      flex: 1;
      min-width: 0;
    }
    .rank {
      font-family: var(--mono);
      font-size: 11px;
      font-weight: 700;
      color: var(--faint);
      background: var(--code-bg);
      border-radius: 6px;
      width: 1.45rem;
      height: 1.45rem;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
    }
    .rank-top { color: var(--accent); background: var(--accent-soft); }
    .stars {
      font-family: var(--mono);
      font-size: 12px;
      color: var(--dim);
      flex-shrink: 0;
    }
    .desc {
      margin: 0;
      color: var(--dim);
      font-size: .88rem;
      line-height: 1.55;
      display: -webkit-box;
      -webkit-line-clamp: 2;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }
    .meta { display: flex; flex-wrap: wrap; gap: .4rem; margin-top: .1rem; }
    .chip {
      font-family: var(--mono);
      font-size: 11px;
      color: var(--dim);
      background: var(--code-bg);
      border-radius: 999px;
      padding: .12rem .5rem;
    }
    .chip-grow { color: var(--accent); background: var(--accent-soft); }
    .chip-muted { color: var(--faint); }

    .empty { color: var(--dim); }

    @media (max-width: 640px) {
      .grid { grid-template-columns: 1fr; }
    }
  </style>
</Base>
