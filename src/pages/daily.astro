---
import Base from '../layouts/Base.astro';

// 开源日报由 github-daily-report 仓库的 GitHub Actions 每天生成，
// 这里在浏览器端读取该仓库的 feed.xml（jsdelivr CDN 优先，raw 回退），
// 每页展示一期，翻页查看往期。
const FEED_SOURCES = [
  'https://cdn.jsdelivr.net/gh/laojiahuo2003/github-daily-report@main/feed.xml',
  'https://raw.githubusercontent.com/laojiahuo2003/github-daily-report/main/feed.xml',
];
const REPO_URL = 'https://github.com/laojiahuo2003/github-daily-report';
const INDEX_URL = 'https://github.com/laojiahuo2003/github-daily-report/blob/main/reports/index.md';
---

<Base title="开源日报 · Jiahuo Lao 的手记" description="每日 GitHub 趋势、飙升榜与新项目发现">
  <header slot="header" class="home-header">
    <div>
      <p class="eyebrow">GitHub Trending · 每日 09:00 / 18:00 更新</p>
      <h1>开源日报</h1>
      <p class="bio">
        自动追踪 GitHub <em>趋势、飙升榜与新项目</em>，数据来自
        <a href={REPO_URL}>github-daily-report</a> 仓库。
      </p>
    </div>
  </header>

  <section>
    <p class="list-head">Daily Report</p>

    <div id="daily-pager">
      <button id="daily-newer" class="daily-nav" type="button" disabled>← 较新</button>
      <span id="daily-indicator" class="daily-indicator">加载中…</span>
      <button id="daily-older" class="daily-nav" type="button" disabled>较旧 →</button>
    </div>

    <div id="daily-view" aria-live="polite"></div>

    <p id="daily-error" hidden>
      加载失败，<a href={REPO_URL}>直接去仓库看报告</a>。
    </p>

    <p class="daily-archive">
      全部历史报告见 <a href={INDEX_URL}>仓库索引</a>
    </p>
  </section>

  <script define:vars={{ FEED_SOURCES }}>
    (function () {
      var view = document.getElementById('daily-view');
      var err = document.getElementById('daily-error');
      var btnNewer = document.getElementById('daily-newer');
      var btnOlder = document.getElementById('daily-older');
      var indicator = document.getElementById('daily-indicator');

      var items = [];
      var idx = 0; // 0 = 最新一期

      // "1 | [name](url) | 🔺2304 | 109k | Python | 🤖 AI / LLM"
      var parseRow = function (line) {
        var cells = line.split('|');
        if (cells.length < 4) return null;
        var cell = cells[1].trim();
        var m = cell.match(/\[([^\]]+)\]\(([^)]+)\)/);
        return {
          rank: cells[0].trim(),
          name: m ? m[1] : cell,
          url: m ? m[2] : '',
          growth: cells[2].trim().replace('🔺', '+'),
          stars: cells[3].trim(),
          lang: cells[4] ? cells[4].trim() : '',
          category: cells[5] ? cells[5].trim() : ''
        };
      };

      var repoLink = function (row) {
        if (!row.url) {
          var span = document.createElement('span');
          span.textContent = row.name;
          return span;
        }
        var a = document.createElement('a');
        a.href = row.url;
        a.target = '_blank';
        a.rel = 'noopener';
        a.textContent = row.name;
        return a;
      };

      var fetchFirstAvailable = function (sources) {
        if (!sources.length) return Promise.reject(new Error('all failed'));
        return fetch(sources[0])
          .then(function (r) {
            if (!r.ok) throw new Error(r.status);
            return r.text();
          })
          .catch(function () {
            return fetchFirstAvailable(sources.slice(1));
          });
      };

      var renderCard = function (item) {
        var title = (item.querySelector('title') || {}).textContent || '';
        var link = (item.querySelector('link') || {}).textContent || '';
        var desc = ((item.querySelector('description') || {}).textContent || '').trim();
        var rows = desc.split('\n').map(parseRow).filter(Boolean);
        var date = title.slice(-10);

        var card = document.createElement('article');
        card.className = 'daily-card';

        var head = document.createElement('div');
        head.className = 'daily-card-head';
        var h2 = document.createElement('h2');
        h2.textContent = date;
        var more = document.createElement('a');
        more.className = 'daily-more';
        more.href = link;
        more.target = '_blank';
        more.rel = 'noopener';
        more.textContent = '完整报告 →';
        head.appendChild(h2);
        head.appendChild(more);
        card.appendChild(head);

        if (!rows.length) {
          var empty = document.createElement('p');
          empty.className = 'daily-hint';
          empty.textContent = '该期为旧格式报告，无飙升榜数据，可点击右上角查看完整报告。';
          card.appendChild(empty);
          return card;
        }

        // 榜首高亮块
        var top = rows[0];
        var topBox = document.createElement('div');
        topBox.className = 'daily-top';
        var topLabel = document.createElement('span');
        topLabel.className = 'daily-top-label';
        topLabel.textContent = '🏆 今日最佳';
        var topName = document.createElement('div');
        topName.className = 'daily-top-name';
        topName.appendChild(repoLink(top));
        var topMeta = document.createElement('div');
        topMeta.className = 'daily-top-meta';
        var g = document.createElement('strong');
        g.textContent = top.growth;
        topMeta.appendChild(g);
        topMeta.appendChild(document.createTextNode(' 今日 · ⭐ ' + top.stars + ' 总星标'));
        if (top.lang) topMeta.appendChild(document.createTextNode(' · ' + top.lang));
        topBox.appendChild(topLabel);
        topBox.appendChild(topName);
        topBox.appendChild(topMeta);
        card.appendChild(topBox);

        // 榜单表格（含表头）
        var table = document.createElement('table');
        table.className = 'daily-table';
        var thead = document.createElement('thead');
        var hr = document.createElement('tr');
        ['#', '项目', '今日', '总⭐', '语言', '分类'].forEach(function (label, i) {
          var th = document.createElement('th');
          th.textContent = label;
          if (i >= 2) th.className = 'daily-num-col';
          hr.appendChild(th);
        });
        thead.appendChild(hr);
        table.appendChild(thead);

        var tbody = document.createElement('tbody');
        rows.forEach(function (row) {
          var tr = document.createElement('tr');
          var tdRank = document.createElement('td');
          tdRank.className = 'daily-rank';
          tdRank.textContent = row.rank;
          var tdName = document.createElement('td');
          tdName.appendChild(repoLink(row));
          var tdGrowth = document.createElement('td');
          tdGrowth.className = 'daily-growth';
          tdGrowth.textContent = row.growth;
          var tdStars = document.createElement('td');
          tdStars.className = 'daily-stars';
          tdStars.textContent = row.stars;
          [tdRank, tdName, tdGrowth, tdStars].forEach(function (td) { tr.appendChild(td); });
          if (row.lang) {
            var tdLang = document.createElement('td');
            tdLang.className = 'daily-lang';
            tdLang.textContent = row.lang;
            tr.appendChild(tdLang);
          }
          if (row.category) {
            var tdCat = document.createElement('td');
            tdCat.className = 'daily-cat';
            tdCat.textContent = row.category;
            tr.appendChild(tdCat);
          }
          tbody.appendChild(tr);
        });
        table.appendChild(tbody);
        card.appendChild(table);

        return card;
      };

      var render = function () {
        view.innerHTML = '';
        view.appendChild(renderCard(items[idx]));
        indicator.textContent = idx === 0
          ? '最新一期'
          : '第 ' + (idx + 1) + ' / ' + items.length + ' 期';
        btnNewer.disabled = idx === 0;
        btnOlder.disabled = idx >= items.length - 1;
      };

      fetchFirstAvailable(FEED_SOURCES)
        .then(function (xml) {
          var doc = new DOMParser().parseFromString(xml, 'text/xml');
          items = Array.from(doc.querySelectorAll('item')).slice(0, 15);
          if (!items.length) throw new Error('empty');
          render();
        })
        .catch(function () {
          view.hidden = true;
          document.getElementById('daily-pager').hidden = true;
          err.hidden = false;
        });

      btnNewer.addEventListener('click', function () {
        if (idx > 0) { idx--; render(); }
      });
      btnOlder.addEventListener('click', function () {
        if (idx < items.length - 1) { idx++; render(); }
      });
    })();
  </script>

  <style>
    .daily-pager {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 1rem;
      margin: 0 0 1rem;
    }
    .daily-nav {
      font-family: var(--mono);
      font-size: 12.5px;
      color: var(--dim);
      background: transparent;
      border: 1px solid var(--rule);
      border-radius: 6px;
      padding: .35rem .8rem;
      cursor: pointer;
    }
    .daily-nav:hover:not(:disabled) { color: var(--accent); border-color: var(--accent); }
    .daily-nav:disabled { opacity: .35; cursor: default; }
    .daily-indicator {
      font-family: var(--mono);
      font-size: 12px;
      color: var(--faint);
      letter-spacing: .05em;
    }

    .daily-card {
      margin: 0 0 1.6rem;
      border: 1px solid var(--rule);
      border-radius: 10px;
      padding: 1.1rem 1.25rem .9rem;
      background: color-mix(in srgb, var(--ground) 60%, transparent);
    }
    .daily-card-head {
      display: flex;
      align-items: baseline;
      justify-content: space-between;
      border-bottom: 1px solid var(--rule);
      padding-bottom: .55rem;
      margin-bottom: .8rem;
    }
    .daily-card-head h2 {
      font-family: var(--mono);
      font-size: 15px;
      font-weight: 600;
      color: var(--ink);
      margin: 0;
      letter-spacing: .04em;
    }
    .daily-more {
      font-family: var(--mono);
      font-size: 12px;
      color: var(--dim);
      text-decoration: none;
    }
    .daily-more:hover { color: var(--accent); }

    .daily-top {
      border-left: 3px solid var(--accent);
      background: var(--accent-soft);
      border-radius: 0 8px 8px 0;
      padding: .6rem .9rem;
      margin-bottom: .8rem;
    }
    .daily-top-label {
      font-family: var(--mono);
      font-size: 11px;
      color: var(--dim);
      letter-spacing: .06em;
    }
    .daily-top-name {
      font-family: var(--serif);
      font-size: 1.05rem;
      font-weight: 600;
      margin: .15rem 0 .2rem;
    }
    .daily-top-name a { color: var(--ink); text-decoration: none; }
    .daily-top-name a:hover { color: var(--accent); }
    .daily-top-meta {
      font-family: var(--mono);
      font-size: 12px;
      color: var(--dim);
    }
    .daily-top-meta strong { color: var(--accent); font-weight: 600; }

    .daily-table {
      width: 100%;
      border-collapse: collapse;
      font-size: .88rem;
    }
    .daily-table th {
      font-family: var(--mono);
      font-size: 11px;
      font-weight: 500;
      color: var(--faint);
      text-align: left;
      padding: .3rem .3rem .45rem;
      border-bottom: 1px solid var(--rule);
      letter-spacing: .05em;
    }
    .daily-table th.daily-num-col { text-align: right; }
    .daily-table td {
      padding: .42rem .3rem;
      border-top: 1px solid var(--rule);
      vertical-align: middle;
    }
    .daily-table tbody tr:first-child td { border-top: none; }
    .daily-rank {
      font-family: var(--mono);
      font-size: 12px;
      color: var(--faint);
      width: 2rem;
    }
    .daily-table a {
      color: var(--ink);
      text-decoration: none;
    }
    .daily-table a:hover { color: var(--accent); }
    .daily-growth,
    .daily-stars,
    .daily-lang {
      font-family: var(--mono);
      font-size: 12px;
      white-space: nowrap;
      text-align: right;
    }
    .daily-growth { color: var(--accent); width: 4.5rem; }
    .daily-stars { color: var(--dim); width: 4.5rem; }
    .daily-lang { color: var(--dim); width: 5.5rem; }
    .daily-cat {
      font-family: var(--mono);
      font-size: 12px;
      color: var(--dim);
      white-space: nowrap;
      text-align: right;
    }
    .daily-hint { color: var(--dim); font-size: .93rem; }
    .daily-archive {
      font-family: var(--mono);
      font-size: 12px;
      color: var(--faint);
      margin-top: .4rem;
    }
    .daily-archive a { color: var(--dim); }
    .daily-archive a:hover { color: var(--accent); }
  </style>
</Base>
