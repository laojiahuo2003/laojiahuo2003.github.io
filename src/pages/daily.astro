---
import Base from '../layouts/Base.astro';

// 开源日报由 github-daily-report 仓库的 GitHub Actions 每天生成，
// 这里在浏览器端读取该仓库的 feed.xml（jsdelivr CDN 优先，raw 回退），
// 每页展示一期完整报告，渲染进 .prose 容器与文章页排版保持一致。
const FEED_SOURCES = [
  'https://cdn.jsdelivr.net/gh/laojiahuo2003/github-daily-report@main/feed.xml',
  'https://raw.githubusercontent.com/laojiahuo2003/github-daily-report/main/feed.xml',
];
const REPO_URL = 'https://github.com/laojiahuo2003/github-daily-report';
---

<Base title="开源日报 · Jiahuo Lao 的手记" description="每日 GitHub 趋势、飙升榜与新项目发现">
  <header slot="header" class="home-header">
    <div>
      <p class="eyebrow">GitHub Trending · 每日 09:00 / 18:00 更新</p>
      <h1>开源日报</h1>
      <p class="bio">
        自动追踪 GitHub <em>趋势、飙升榜与新项目</em>，数据来自
        <a href={REPO_URL}>github-daily-report</a> 仓库。
      </p>
    </div>
  </header>

  <section>
    <div id="daily-pager">
      <button id="daily-newer" class="daily-nav" type="button" disabled>← 较新</button>
      <span id="daily-indicator" class="daily-indicator">加载中…</span>
      <button id="daily-older" class="daily-nav" type="button" disabled>较旧 →</button>
    </div>

    <article id="daily-view" aria-live="polite"></article>

    <p id="daily-error" hidden>
      加载失败，<a href={REPO_URL}>直接去仓库看报告</a>。
    </p>
  </section>

  <script define:vars={{ FEED_SOURCES }}>
    (function () {
      var view = document.getElementById('daily-view');
      var err = document.getElementById('daily-error');
      var btnNewer = document.getElementById('daily-newer');
      var btnOlder = document.getElementById('daily-older');
      var indicator = document.getElementById('daily-indicator');

      var items = [];
      var idx = 0; // 0 = 最新一期

      // ---------- 轻量 markdown 渲染（覆盖报告用到的语法子集） ----------
      var esc = function (s) {
        return s
          .replace(/&/g, '&amp;')
          .replace(/</g, '&lt;')
          .replace(/>/g, '&gt;')
          .replace(/"/g, '&quot;');
      };

      var inline = function (s) {
        s = esc(s);
        s = s.replace(/`([^`]+)`/g, '<code>$1</code>');
        s = s.replace(/\*\*([^*]+)\*\*/g, '<strong>$1</strong>');
        s = s.replace(/\[([^\]]+)\]\(([^)\s]+)\)/g, function (_, text, url) {
          var ext = url.indexOf('http') === 0;
          return (
            '<a href="' + url + '"' +
            (ext ? ' target="_blank" rel="noopener"' : '') +
            '>' + text + '</a>'
          );
        });
        return s;
      };

      var renderMarkdown = function (md) {
        var lines = md.split('\n');
        var html = '';
        var table = [];
        var list = null; // { ordered: bool, items: [html...] }

        var flushTable = function () {
          if (!table.length) return;
          var out = '<div class="daily-table-wrap"><table><thead><tr>';
          table[0].forEach(function (c) { out += '<th>' + inline(c) + '</th>'; });
          out += '</tr></thead><tbody>';
          for (var r = 2; r < table.length; r++) {
            out += '<tr>';
            table[r].forEach(function (c) { out += '<td>' + inline(c) + '</td>'; });
            out += '</tr>';
          }
          out += '</tbody></table></div>';
          html += out;
          table = [];
        };

        var flushList = function () {
          if (!list) return;
          var tag = list.ordered ? 'ol' : 'ul';
          html += '<' + tag + '>' + list.items.map(function (it) { return '<li>' + it + '</li>'; }).join('') + '</' + tag + '>';
          list = null;
        };

        for (var i = 0; i < lines.length; i++) {
          var s = lines[i].trim();

          if (s.charAt(0) === '|') {
            flushList();
            table.push(s.replace(/^\|/, '').replace(/\|$/, '').split('|').map(function (x) { return x.trim(); }));
            continue;
          }
          flushTable();

          if (!s) { flushList(); continue; }
          if (s === '---') { flushList(); html += '<hr>'; continue; }

          var h = s.match(/^(#{1,3})\s+(.*)$/);
          if (h) {
            flushList();
            if (h[1].length === 1) continue; // 主标题：日期已在卡片头
            var level = h[1].length;
            html += '<h' + level + '>' + inline(h[2]) + '</h' + level + '>';
            continue;
          }

          // 列表项 / 缩进的引用（列表项的第二行简介）
          var li = s.match(/^(?:[-*]|\d+\.)\s+(.*)$/);
          var cont = s.match(/^&gt;\s*(.*)$/) || s.match(/^>\s*(.*)$/);
          if (li) {
            if (!list) list = { ordered: /^\d/.test(s), items: [] };
            list.items.push(inline(li[1]));
            continue;
          }
          if (cont) {
            if (list && list.items.length) {
              list.items[list.items.length - 1] += '<br><span class="daily-li-desc">' + inline(cont[1]) + '</span>';
            } else {
              html += '<blockquote>' + inline(cont[1]) + '</blockquote>';
            }
            continue;
          }

          flushList();
          if (/^\*[^*].*\*$/.test(s)) {
            html += '<p class="daily-foot">' + inline(s.slice(1, -1)) + '</p>'; // 报告生成时间行
            continue;
          }
          html += '<p>' + inline(s) + '</p>';
        }
        flushTable();
        flushList();
        return html;
      };

      // ---------- feed 加载（双源并发，取数据最新的一份） ----------
      // raw 永远最新但国内可能连不上；jsdelivr 国内稳定但缓存可能滞后
      var fetchText = function (url) {
        return fetch(url).then(function (r) {
          if (!r.ok) throw new Error(r.status);
          return r.text();
        });
      };

      var parseFeed = function (text) {
        var doc = new DOMParser().parseFromString(text, 'text/xml');
        if (doc.getElementsByTagName('parsererror').length) throw new Error('parse');
        var items = Array.from(doc.getElementsByTagName('item'));
        if (!items.length) throw new Error('empty');
        return items;
      };

      // guid 含报告文件名（ISO 日期），字典序比较即时间序
      var latestStamp = function (items) {
        var g = (items[0].querySelector('guid') || {}).textContent || '';
        return g;
      };

      var itemDate = function (item) {
        var title = (item.querySelector('title') || {}).textContent || '';
        return title.slice(-10);
      };

      var itemContent = function (item) {
        return (item.querySelector('description') || {}).textContent || '';
      };

      var render = function () {
        var item = items[idx];
        var date = itemDate(item);
        var content = itemContent(item);

        view.innerHTML = '';
        var card = document.createElement('div');
        card.className = 'daily-report';

        var head = document.createElement('div');
        head.className = 'daily-report-head';
        var h2 = document.createElement('h2');
        h2.textContent = date;
        head.appendChild(h2);
        card.appendChild(head);

        var prose = document.createElement('div');
        prose.className = 'prose';
        if (content.trim()) {
          prose.innerHTML = renderMarkdown(content);
        } else {
          prose.innerHTML = '<p>该期报告暂无内容。</p>';
        }
        card.appendChild(prose);
        view.appendChild(card);

        indicator.textContent = idx === 0
          ? '最新一期'
          : '第 ' + (idx + 1) + ' / ' + items.length + ' 期';
        btnNewer.disabled = idx === 0;
        btnOlder.disabled = idx >= items.length - 1;
      };

      Promise.all(FEED_SOURCES.map(function (u) { return fetchText(u).then(parseFeed).catch(function () { return null; }); }))
        .then(function (results) {
          var docs = results.filter(Boolean);
          if (!docs.length) throw new Error('all failed');
          // 必须按 XML 解析：HTML 模式下 CDATA 会被当作注释、
          // 在内容首个 ">" 处截断，导致报告前半部分丢失
          var best = docs.reduce(function (a, b) {
            return latestStamp(a) >= latestStamp(b) ? a : b;
          });
          items = best.slice(0, 10);
          render();
        })
        .catch(function () {
          view.hidden = true;
          document.getElementById('daily-pager').hidden = true;
          err.hidden = false;
        });

      btnNewer.addEventListener('click', function () {
        if (idx > 0) { idx--; render(); }
      });
      btnOlder.addEventListener('click', function () {
        if (idx < items.length - 1) { idx++; render(); }
      });
    })();
  </script>

  <style>
    .daily-pager {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 1rem;
      margin: 0 0 1.4rem;
    }
    .daily-nav {
      font-family: var(--mono);
      font-size: 12.5px;
      color: var(--dim);
      background: transparent;
      border: 1px solid var(--rule);
      border-radius: 6px;
      padding: .35rem .8rem;
      cursor: pointer;
    }
    .daily-nav:hover:not(:disabled) { color: var(--accent); border-color: var(--accent); }
    .daily-nav:disabled { opacity: .35; cursor: default; }
    .daily-indicator {
      font-family: var(--mono);
      font-size: 12px;
      color: var(--faint);
      letter-spacing: .05em;
    }

    .daily-report-head {
      border-bottom: 1px solid var(--rule);
      padding-bottom: .55rem;
      margin-bottom: 1.2rem;
    }
    .daily-report-head h2 {
      font-family: var(--mono);
      font-size: 15px;
      font-weight: 600;
      color: var(--ink);
      margin: 0;
      letter-spacing: .04em;
    }

    /* 宽表格在窄栏内横向滚动，不撑破版式 */
    .daily-table-wrap { overflow-x: auto; }
    .daily-table-wrap table { min-width: 620px; }

    .daily-li-desc {
      display: inline-block;
      font-size: .88em;
      color: var(--dim);
    }
    .daily-foot {
      font-family: var(--mono);
      font-size: 12px;
      color: var(--faint);
    }
  </style>
</Base>
