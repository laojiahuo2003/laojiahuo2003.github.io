---
import Base from '../layouts/Base.astro';

// 开源日报由 github-daily-report 仓库的 GitHub Actions 每天生成，
// 这里在浏览器端直接读取该仓库的 feed.xml，保证内容始终最新。
const FEED_URL =
  'https://raw.githubusercontent.com/laojiahuo2003/github-daily-report/main/feed.xml';
const REPO_URL = 'https://github.com/laojiahuo2003/github-daily-report';
---

<Base title="开源日报 · Jiahuo Lao 的手记" description="每日 GitHub 趋势、飙升榜与新项目发现">
  <header slot="header" class="home-header">
    <div>
      <p class="eyebrow">GitHub Trending · 每日 09:00 / 18:00 更新</p>
      <h1>开源日报</h1>
      <p class="bio">
        自动追踪 GitHub <em>趋势、飙升榜与新项目</em>，数据来自
        <a href={REPO_URL}>github-daily-report</a> 仓库。
      </p>
    </div>
  </header>

  <section>
    <p class="list-head">Daily Report Log</p>
    <div id="daily-list" aria-live="polite">
      <p class="daily-hint">加载中…</p>
    </div>
    <p id="daily-error" hidden>
      加载失败，<a href={REPO_URL}>直接去仓库看报告</a>。
    </p>
  </section>

  <script define:vars={{ FEED_URL }}>
    (function () {
      var list = document.getElementById('daily-list');
      var err = document.getElementById('daily-error');

      // "1 | [name](url) | 🔺2304 | 109k" -> {rank, name, url, growth, stars}
      var parseRow = function (line) {
        var cells = line.split('|');
        if (cells.length < 4) return null;
        var cell = cells[1].trim();
        var m = cell.match(/\[([^\]]+)\]\(([^)]+)\)/); // 新格式带链接
        var name = m ? m[1] : cell; // 旧格式纯文本
        return {
          rank: cells[0].trim(),
          name: name,
          url: m ? m[2] : '',
          growth: cells[2].trim().replace('🔺', '+'),
          stars: cells[3].trim()
        };
      };

      var repoLink = function (row) {
        if (!row.url) {
          var span = document.createElement('span');
          span.textContent = row.name;
          return span;
        }
        var a = document.createElement('a');
        a.href = row.url;
        a.target = '_blank';
        a.rel = 'noopener';
        a.textContent = row.name;
        return a;
      };

      fetch(FEED_URL)
        .then(function (r) {
          if (!r.ok) throw new Error(r.status);
          return r.text();
        })
        .then(function (xml) {
          var doc = new DOMParser().parseFromString(xml, 'text/xml');
          var items = Array.from(doc.querySelectorAll('item')).slice(0, 15);
          if (!items.length) throw new Error('empty');

          list.innerHTML = '';
          items.forEach(function (item) {
            var title = (item.querySelector('title') || {}).textContent || '';
            var link = (item.querySelector('link') || {}).textContent || '';
            var desc = ((item.querySelector('description') || {}).textContent || '').trim();
            var rows = desc.split('\n').map(parseRow).filter(Boolean);

            var date = title.slice(-10);

            // —— 卡片 ——
            var card = document.createElement('article');
            card.className = 'daily-card';

            var head = document.createElement('div');
            head.className = 'daily-card-head';
            var h2 = document.createElement('h2');
            h2.textContent = date;
            var more = document.createElement('a');
            more.className = 'daily-more';
            more.href = link;
            more.target = '_blank';
            more.rel = 'noopener';
            more.textContent = '完整报告 →';
            head.appendChild(h2);
            head.appendChild(more);
            card.appendChild(head);

            if (!rows.length) {
              var empty = document.createElement('p');
              empty.className = 'daily-hint';
              empty.textContent = '本期无飙升榜数据';
              card.appendChild(empty);
              list.appendChild(card);
              return;
            }

            // 榜首高亮块：第一眼看到当日最火项目
            var top = rows[0];
            var topBox = document.createElement('div');
            topBox.className = 'daily-top';
            var topLabel = document.createElement('span');
            topLabel.className = 'daily-top-label';
            topLabel.textContent = '🏆 今日最佳';
            var topName = document.createElement('div');
            topName.className = 'daily-top-name';
            topName.appendChild(repoLink(top));
            var topMeta = document.createElement('div');
            topMeta.className = 'daily-top-meta';
            var g = document.createElement('strong');
            g.textContent = top.growth;
            topMeta.appendChild(g);
            topMeta.appendChild(document.createTextNode(' 今日 · ⭐ ' + top.stars + ' 总星标'));
            topBox.appendChild(topLabel);
            topBox.appendChild(topName);
            topBox.appendChild(topMeta);
            card.appendChild(topBox);

            // 榜单表格
            var table = document.createElement('table');
            table.className = 'daily-table';
            var tbody = document.createElement('tbody');
            rows.forEach(function (row) {
              var tr = document.createElement('tr');
              var tdRank = document.createElement('td');
              tdRank.className = 'daily-rank';
              tdRank.textContent = row.rank;
              var tdName = document.createElement('td');
              tdName.appendChild(repoLink(row));
              var tdGrowth = document.createElement('td');
              tdGrowth.className = 'daily-growth';
              tdGrowth.textContent = row.growth;
              var tdStars = document.createElement('td');
              tdStars.className = 'daily-stars';
              tdStars.textContent = row.stars;
              tr.appendChild(tdRank);
              tr.appendChild(tdName);
              tr.appendChild(tdGrowth);
              tr.appendChild(tdStars);
              tbody.appendChild(tr);
            });
            table.appendChild(tbody);
            card.appendChild(table);

            list.appendChild(card);
          });
        })
        .catch(function () {
          list.hidden = true;
          err.hidden = false;
        });
    })();
  </script>

  <style>
    .daily-card {
      margin: 0 0 2.2rem;
      border: 1px solid var(--rule);
      border-radius: 10px;
      padding: 1.1rem 1.25rem .9rem;
      background: color-mix(in srgb, var(--ground) 60%, transparent);
    }
    .daily-card-head {
      display: flex;
      align-items: baseline;
      justify-content: space-between;
      border-bottom: 1px solid var(--rule);
      padding-bottom: .55rem;
      margin-bottom: .8rem;
    }
    .daily-card-head h2 {
      font-family: var(--mono);
      font-size: 15px;
      font-weight: 600;
      color: var(--ink);
      margin: 0;
      letter-spacing: .04em;
    }
    .daily-more {
      font-family: var(--mono);
      font-size: 12px;
      color: var(--dim);
      text-decoration: none;
    }
    .daily-more:hover { color: var(--accent); }

    .daily-top {
      border-left: 3px solid var(--accent);
      background: var(--accent-soft);
      border-radius: 0 8px 8px 0;
      padding: .6rem .9rem;
      margin-bottom: .8rem;
    }
    .daily-top-label {
      font-family: var(--mono);
      font-size: 11px;
      color: var(--dim);
      letter-spacing: .06em;
    }
    .daily-top-name {
      font-family: var(--serif);
      font-size: 1.05rem;
      font-weight: 600;
      margin: .15rem 0 .2rem;
    }
    .daily-top-name a { color: var(--ink); text-decoration: none; }
    .daily-top-name a:hover { color: var(--accent); }
    .daily-top-meta {
      font-family: var(--mono);
      font-size: 12px;
      color: var(--dim);
    }
    .daily-top-meta strong { color: var(--accent); font-weight: 600; }

    .daily-table {
      width: 100%;
      border-collapse: collapse;
      font-size: .88rem;
    }
    .daily-table td {
      padding: .42rem .3rem;
      border-top: 1px solid var(--rule);
      vertical-align: middle;
    }
    .daily-table tr:first-child td { border-top: none; }
    .daily-rank {
      font-family: var(--mono);
      font-size: 12px;
      color: var(--faint);
      width: 2rem;
    }
    .daily-table a {
      color: var(--ink);
      text-decoration: none;
    }
    .daily-table a:hover { color: var(--accent); }
    .daily-growth {
      font-family: var(--mono);
      font-size: 12px;
      color: var(--accent);
      text-align: right;
      white-space: nowrap;
      width: 4.5rem;
    }
    .daily-stars {
      font-family: var(--mono);
      font-size: 12px;
      color: var(--dim);
      text-align: right;
      white-space: nowrap;
      width: 4.5rem;
    }
    .daily-hint { color: var(--dim); font-size: .93rem; }
  </style>
</Base>
