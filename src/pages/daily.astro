---
import Base from '../layouts/Base.astro';

// 开源日报由 github-daily-report 仓库的 GitHub Actions 每天生成结构化 feed.json，
// 浏览器端读取（jsdelivr CDN 优先，raw 回退），每页一期，按期刊排版渲染。
// 注意：正文全部由 JS innerHTML 注入，Astro scoped 样式对它不生效，
// 因此本页样式统一走 is:global，并用 body.daily-page 限定作用域。
const FEED_SOURCES = [
  'https://cdn.jsdelivr.net/gh/laojiahuo2003/github-daily-report@main/feed.json',
  'https://raw.githubusercontent.com/laojiahuo2003/github-daily-report/main/feed.json',
];
const REPO_URL = 'https://github.com/laojiahuo2003/github-daily-report';
---

<Base title="开源日报 · Jiahuo Lao 的手记" description="每日 GitHub 趋势、飙升榜与新项目发现" bodyClass="daily-page">
  <header slot="header" class="masthead">
    <div class="masthead-top">
      <p class="eyebrow">GitHub Trending · 每日 09:00 / 18:00 更新</p>
      <span class="issue-no" id="issue-no">ISSUE #—</span>
    </div>
    <h1 class="masthead-date" id="masthead-date">开源日报</h1>
    <p class="statline" id="statline">
      自动追踪 GitHub 趋势、飙升榜与新项目，数据来自
      <a href={REPO_URL}>github-daily-report</a>。
    </p>
  </header>

  <section>
    <div id="daily-pager" class="daily-pager">
      <button id="daily-newer" class="daily-nav" type="button" disabled>← 较新</button>
      <span id="daily-indicator" class="daily-indicator">加载中…</span>
      <button id="daily-older" class="daily-nav" type="button" disabled>较旧 →</button>
    </div>

    <article id="daily-view" aria-live="polite">
      <div class="skel skel-hero"></div>
      <div class="grid">
        <div class="skel skel-card"></div>
        <div class="skel skel-card"></div>
        <div class="skel skel-card"></div>
        <div class="skel skel-card"></div>
      </div>
    </article>

    <p id="daily-error" hidden>
      加载失败，<a href={REPO_URL}>直接去仓库看报告</a>。
    </p>
  </section>

  <script define:vars={{ FEED_SOURCES, REPO_URL }}>
    (function () {
      var view = document.getElementById('daily-view');
      var err = document.getElementById('daily-error');
      var btnNewer = document.getElementById('daily-newer');
      var btnOlder = document.getElementById('daily-older');
      var indicator = document.getElementById('daily-indicator');
      var issueNo = document.getElementById('issue-no');
      var mastDate = document.getElementById('masthead-date');
      var statline = document.getElementById('statline');

      var items = [];
      var totalReports = 0;
      var idx = 0; // 0 = 最新一期

      // ---------- 安全工具 ----------
      var esc = function (s) {
        return String(s == null ? '' : s)
          .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;')
          .replace(/"/g, '&quot;');
      };
      var safeUrl = function (u) {
        return /^https?:\/\//.test(u || '') ? u : '';
      };
      var fmtStars = function (n) {
        n = +n || 0;
        if (n >= 1000) {
          var s = (n / 1000).toFixed(1);
          if (/\.0$/.test(s)) s = s.slice(0, -2);
          return s + 'k';
        }
        return String(n);
      };
      var fmtDate = function (d) {
        var m = /^(\d{4})-(\d{2})-(\d{2})$/.exec(d || '');
        return m ? (+m[1]) + ' 年 ' + (+m[2]) + ' 月 ' + (+m[3]) + ' 日' : (d || '');
      };

      // ---------- GitHub 官方语言色（常用子集，未命中则不着色） ----------
      var LANG_COLORS = {
        TypeScript: '#3178c6', JavaScript: '#f1e05a', Python: '#3572A5',
        Rust: '#dea584', Go: '#00ADD8', 'C++': '#f34b7d', C: '#555555',
        'C#': '#178600', Java: '#b07219', Ruby: '#701516', PHP: '#4F5D95',
        Swift: '#F05138', Kotlin: '#A97BFF', Dart: '#00B4AB', Vue: '#41b883',
        HTML: '#e34c26', CSS: '#663399', SCSS: '#c6538c', Shell: '#89e051',
        Lua: '#000080', Haskell: '#5e5086', Elixir: '#6e4a7e', Zig: '#ec915c',
        R: '#198CE7', Scala: '#c22d40', Clojure: '#db5855', Perl: '#0298c3',
        'Jupyter Notebook': '#DA5B0B', Nix: '#7e7eff', OCaml: '#ef7a08',
        Solidity: '#AA6746', Assembly: '#6E4C13', PowerShell: '#012456',
        CoffeeScript: '#244776', MDX: '#fcb32c',
      };
      var langDot = function (lang) {
        if (!lang) return '';
        var c = LANG_COLORS[lang];
        return '<span class="lang"><i class="dot"' +
          (c ? ' style="background:' + c + '"' : '') + '></i>' + esc(lang) + '</span>';
      };
      // 分类名自带 emoji 前缀（如 "🤖 AI / LLM"），期刊标题里只留文字
      var cleanCat = function (c) {
        return String(c || '')
          .replace(/^[\u{1F000}-\u{1FAFF}\u{2600}-\u{27BF}\u{2B00}-\u{2BFF}\u{FE0F}\u{200D}]+\s*/u, '')
          .trim();
      };

      // ---------- 卡片渲染 ----------
      var repoLink = function (r) {
        var url = safeUrl(r.url);
        var name = '<span class="rname">' + esc(r.name) + '</span>';
        return url
          ? '<a href="' + esc(url) + '" target="_blank" rel="noopener noreferrer">' + name + '</a>'
          : name;
      };

      var repoCard = function (r, opts) {
        opts = opts || {};
        var meta = [];
        var langHtml = langDot(r.language);
        if (langHtml) meta.push(langHtml);
        if (opts.badge) meta.push('<span class="chip chip-grow">' + esc(opts.badge) + '</span>');
        else if (+r.growth > 0) meta.push('<span class="chip chip-grow">+' + (+r.growth) + '/日</span>');
        else if (+r.weekly_growth > 0) meta.push('<span class="chip chip-grow">+' + (+r.weekly_growth) + '/周</span>');
        if (r.source) meta.push('<span class="chip chip-muted">' + esc(r.source) + '</span>');
        if (r.created) meta.push('<span class="chip chip-muted">' + esc(r.created) + '</span>');

        return '<article class="card">' +
          '<div class="card-top">' + repoLink(r) +
            '<span class="stars">⭐ ' + esc(fmtStars(r.stars)) + '</span></div>' +
          (r.description ? '<p class="desc">' + esc(r.description) + '</p>' : '') +
          (meta.length ? '<div class="meta">' + meta.join('') + '</div>' : '') +
          '</article>';
      };

      var sec = function (title, count) {
        return '<h3 class="sec"><span class="sec-name">' + title + '</span>' +
          (count != null ? '<span class="sec-count">' + count + '</span>' : '') +
          '<span class="sec-rule"></span></h3>';
      };

      var grid = function (projects) {
        return '<div class="grid">' + projects.map(function (p) { return repoCard(p); }).join('') + '</div>';
      };

      // ---------- 头版头条 ----------
      var heroCard = function (b) {
        var stats = [];
        if (b.stars_fmt || +b.stars) {
          stats.push('<span class="hstat"><b>' + esc(fmtStars(b.stars)) + '</b>总星标</span>');
        }
        if (+b.growth > 0) {
          stats.push('<span class="hstat hstat-grow"><b>+' + (+b.growth) + '</b>今日增长</span>');
        }
        var tail = [];
        if (b.category) tail.push(esc(cleanCat(b.category)));
        if (b.created) tail.push('创建于 ' + esc(b.created));
        if (tail.length) stats.push('<span class="hstat hstat-quiet">' + tail.join(' · ') + '</span>');

        var url = safeUrl(b.url);
        var name = '<span class="rname">' + esc(b.name) + '</span>';
        return '<div class="hero">' +
          '<p class="hero-kicker">今日最佳</p>' +
          '<h2 class="hero-name">' +
            (url ? '<a href="' + esc(url) + '" target="_blank" rel="noopener noreferrer">' + name + '</a>' : name) +
          '</h2>' +
          (b.description ? '<p class="hero-desc">' + esc(b.description) + '</p>' : '') +
          '<div class="hero-foot">' +
            '<div class="hero-stats">' + stats.join('') + '</div>' +
            langDot(b.language) +
          '</div>' +
          '</div>';
      };

      // ---------- 飙升榜：名次 + 增长比例条 ----------
      var growOf = function (r) {
        return +r.growth > 0 ? +r.growth : (+r.weekly_growth > 0 ? +r.weekly_growth : 0);
      };
      var board = function (projects) {
        var maxG = 1;
        projects.forEach(function (p) { maxG = Math.max(maxG, growOf(p)); });
        var rows = projects.map(function (p, i) {
          var rank = i + 1;
          var top = rank <= 3;
          var g = growOf(p);
          var w = Math.max(6, Math.round(g / maxG * 100));
          var url = safeUrl(p.url);
          var name = '<span class="rname">' + esc(p.name) + '</span>';
          return '<a class="brow" href="' + esc(url || '#') + '"' +
            (url ? ' target="_blank" rel="noopener noreferrer"' : '') + '>' +
            '<span class="rank' + (top ? ' rank-top' : '') + '">' + rank + '</span>' +
            '<span class="b-main">' + name +
              (p.description ? '<span class="b-desc">' + esc(p.description) + '</span>' : '') +
            '</span>' +
            '<span class="b-lang">' + langDot(p.language) + '</span>' +
            '<span class="b-stars">⭐ ' + esc(fmtStars(p.stars)) + '</span>' +
            '<span class="b-grow">' +
              '<i class="b-track"><i class="b-fill" style="width:' + w + '%"></i></i>' +
              '<b>+' + g + '</b>' +
            '</span>' +
          '</a>';
        }).join('');
        return '<div class="board">' +
          '<div class="brow brow-head"><span class="rank">#</span><span class="b-main">项目</span>' +
          '<span class="b-lang">语言</span><span class="b-stars">星标</span><span class="b-grow">日增</span></div>' +
          rows + '</div>';
      };

      // ---------- 整期渲染 ----------
      var renderReport = function (r) {
        var html = '';
        var total = 0;
        var secCount = 0;
        total += r.best ? 1 : 0;
        total += (r.leaderboard || []).length;
        total += (r.fast_growing || []).length;
        total += (r.monthly || []).length;
        (r.by_category || []).forEach(function (g) { total += g.projects.length; });
        (r.new_projects || []).forEach(function (g) { total += g.projects.length; });
        (r.explored || []).forEach(function (g) { total += g.projects.length; });
        total += (r.newly_discovered || []).length;

        if (r.best) {
          html += heroCard(r.best);
          secCount++;
        }
        if ((r.leaderboard || []).length) {
          html += sec('今日飙升榜', r.leaderboard.length) + board(r.leaderboard);
          secCount++;
        }
        if ((r.fast_growing || []).length) {
          html += sec('快速增长项目', r.fast_growing.length) + grid(r.fast_growing);
          secCount++;
        }
        if ((r.monthly || []).length) {
          html += sec('本月新星', r.monthly.length) + grid(r.monthly);
          secCount++;
        }
        (r.by_category || []).forEach(function (g) {
          if (g.projects.length) { html += sec(cleanCat(g.category), g.projects.length) + grid(g.projects); secCount++; }
        });
        (r.new_projects || []).forEach(function (g) {
          if (g.projects.length) { html += sec('新项目 · ' + cleanCat(g.category), g.projects.length) + grid(g.projects); secCount++; }
        });
        (r.explored || []).forEach(function (g) {
          if (g.projects.length) { html += sec('深度探索 · ' + g.strategy, g.projects.length) + grid(g.projects); secCount++; }
        });
        if ((r.newly_discovered || []).length) {
          html += sec('新发现项目', r.newly_discovered.length) + grid(r.newly_discovered);
          secCount++;
        }

        view.innerHTML = html || '<p class="empty">本期暂无数据。</p>';

        mastDate.textContent = fmtDate(r.date);
        issueNo.textContent = 'ISSUE #' + (totalReports - idx);
        statline.innerHTML = '共 <b>' + total + '</b> 个项目 · <b>' + secCount +
          '</b> 个分区 · 数据来自 <a href="' + esc(REPO_URL) + '">github-daily-report</a>';
      };

      var render = function () {
        renderReport(items[idx]);
        indicator.textContent = '第 ' + (totalReports - idx) + ' 期 / 共 ' + totalReports + ' 期';
        btnNewer.disabled = idx === 0;
        btnOlder.disabled = idx >= items.length - 1;
        syncHash();
      };

      // ---------- URL 状态：#issue-N 可分享、可恢复 ----------
      var syncHash = function () {
        try {
          var h = '#issue-' + (totalReports - idx);
          if (location.hash !== h) history.replaceState(null, '', h);
        } catch (e) {}
      };
      var idxFromHash = function () {
        var m = /^#issue-(\d+)$/.exec(location.hash || '');
        if (!m) return 0;
        var i = totalReports - +m[1];
        return Math.max(0, Math.min(items.length - 1, i));
      };

      // ---------- feed 加载 ----------
      // 双源并发：首个成功立即渲染，更新的源到达后再升级。
      // 每个源单独加 6s 超时——raw 在国内常挂起几十秒，绝不能拖慢 jsdelivr 的首屏。
      var parseFeed = function (text) {
        var data = JSON.parse(text);
        if (!data || !Array.isArray(data.reports) || !data.reports.length) throw new Error('empty');
        return data;
      };

      var showError = function () {
        view.hidden = true;
        document.getElementById('daily-pager').hidden = true;
        err.hidden = false;
      };

      var loadFeed = function () {
        var rendered = false;
        var bestUpdated = '';

        var apply = function (data) {
          // 已渲染且新数据不比现有新 → 跳过（避免旧源覆盖新源）
          if (rendered && (data.updated || '') <= bestUpdated) return;
          bestUpdated = data.updated || '';
          totalReports = data.reports.length;
          items = data.reports.slice(0, 10);
          idx = idxFromHash();
          render();
          rendered = true;
        };

        var jobs = FEED_SOURCES.map(function (url) {
          var ctrl = typeof AbortController !== 'undefined' ? new AbortController() : null;
          var timer = ctrl ? setTimeout(function () { ctrl.abort(); }, 6000) : null;
          return fetch(url, ctrl ? { signal: ctrl.signal } : {})
            .then(function (r) { if (!r.ok) throw new Error(r.status); return r.text(); })
            .then(parseFeed)
            .then(apply)
            .catch(function () {})
            .then(function () { if (timer) clearTimeout(timer); });
        });

        Promise.all(jobs).then(function () {
          if (!rendered) showError();
        });
      };

      loadFeed();

      // ---------- 翻期交互 ----------
      var go = function (d) {
        var n = idx + d;
        if (n >= 0 && n < items.length) { idx = n; render(); }
      };
      btnNewer.addEventListener('click', function () { go(-1); });
      btnOlder.addEventListener('click', function () { go(1); });
      document.addEventListener('keydown', function (e) {
        if (e.altKey || e.metaKey || e.ctrlKey) return;
        var t = e.target;
        if (t && /^(input|textarea|select)$/i.test(t.tagName)) return;
        if (e.key === 'ArrowLeft') go(-1);
        else if (e.key === 'ArrowRight') go(1);
      });
    })();
  </script>

  <style is:global>
    /* 日报是期刊排版而非正文，比文章页宽，容纳榜单与双栏卡片 */
    body.daily-page .wrap { max-width: 60rem; }
    @media (max-width: 900px) { body.daily-page .wrap { max-width: 42rem; } }
  </style>

  <style is:global>
    /* ============ 报头 ============ */
    body.daily-page .masthead { margin-bottom: 2.75rem; }
    body.daily-page .masthead-top {
      display: flex;
      align-items: baseline;
      justify-content: space-between;
      gap: 1rem;
    }
    body.daily-page .issue-no {
      font-family: var(--mono);
      font-size: 11px;
      letter-spacing: .18em;
      color: var(--faint);
      white-space: nowrap;
    }
    body.daily-page .masthead-date {
      font-family: var(--serif);
      font-weight: 600;
      font-size: 2.15rem;
      line-height: 1.2;
      letter-spacing: .01em;
      margin: 0 0 .7rem;
      text-wrap: balance;
    }
    body.daily-page .statline {
      margin: 0;
      color: var(--dim);
      font-size: .92rem;
      padding-top: .8rem;
      border-top: 1px solid var(--rule);
    }
    body.daily-page .statline b {
      font-family: var(--mono);
      font-weight: 600;
      color: var(--ink);
    }

    /* ============ 翻期 ============ */
    body.daily-page .daily-pager {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 1rem;
      margin: 0 0 1.8rem;
    }
    body.daily-page .daily-nav {
      font-family: var(--mono);
      font-size: 12.5px;
      color: var(--dim);
      background: transparent;
      border: 1px solid var(--rule);
      border-radius: 6px;
      padding: .35rem .8rem;
      cursor: pointer;
      transition: color var(--dur-fast) var(--ease), border-color var(--dur-fast) var(--ease);
    }
    body.daily-page .daily-nav:hover:not(:disabled) { color: var(--accent); border-color: var(--accent); }
    body.daily-page .daily-nav:disabled { opacity: .35; cursor: default; }
    body.daily-page .daily-indicator {
      font-family: var(--mono);
      font-size: 12px;
      color: var(--faint);
      letter-spacing: .05em;
    }

    /* ============ 分区标题：eyebrow 风格 + 延伸细线 ============ */
    body.daily-page .sec {
      display: flex;
      align-items: center;
      gap: .6rem;
      margin: 2.4rem 0 1rem;
    }
    body.daily-page .sec-name {
      font-family: var(--mono);
      font-size: 12px;
      font-weight: 600;
      letter-spacing: .18em;
      text-transform: uppercase;
      color: var(--ink);
    }
    body.daily-page .sec-count {
      font-family: var(--mono);
      font-size: 11px;
      font-weight: 500;
      color: var(--accent);
      background: var(--accent-soft);
      border-radius: 999px;
      padding: .1rem .55rem;
    }
    body.daily-page .sec-rule { flex: 1; height: 1px; background: var(--rule); }

    /* ============ 头版头条 ============ */
    body.daily-page .hero {
      border: 1px solid var(--rule);
      border-left: 3px solid var(--accent);
      border-radius: 12px;
      padding: 1.4rem 1.6rem 1.3rem;
      background: var(--accent-soft);
    }
    body.daily-page .hero-kicker {
      font-family: var(--mono);
      font-size: 11px;
      letter-spacing: .22em;
      text-transform: uppercase;
      color: var(--accent);
      margin: 0 0 .55rem;
    }
    body.daily-page .hero-name { font-size: 1.3rem; margin: 0 0 .5rem; }
    body.daily-page .hero-name a { color: var(--ink); text-decoration: none; }
    body.daily-page .hero-name a:hover { color: var(--accent); }
    body.daily-page .hero-name .rname {
      font-family: var(--mono);
      font-size: 1.15rem;
      overflow-wrap: anywhere;
    }
    body.daily-page .hero-desc {
      color: var(--dim);
      margin: 0 0 1.1rem;
      line-height: 1.65;
      font-size: .95rem;
      max-width: 62ch;
    }
    body.daily-page .hero-foot {
      display: flex;
      align-items: center;
      justify-content: space-between;
      flex-wrap: wrap;
      gap: .8rem;
    }
    body.daily-page .hero-stats { display: flex; flex-wrap: wrap; gap: 1.4rem; align-items: baseline; }
    body.daily-page .hstat {
      font-family: var(--mono);
      font-size: 11.5px;
      color: var(--faint);
      display: inline-flex;
      align-items: baseline;
      gap: .45rem;
    }
    body.daily-page .hstat b {
      font-size: 1.45rem;
      font-weight: 600;
      color: var(--ink);
      letter-spacing: .01em;
    }
    body.daily-page .hstat-grow b { color: var(--accent); }
    body.daily-page .hstat-quiet { font-size: 11.5px; }

    /* ============ 语言色点 ============ */
    body.daily-page .lang {
      font-family: var(--mono);
      font-size: 11.5px;
      color: var(--dim);
      display: inline-flex;
      align-items: center;
      gap: .38rem;
      white-space: nowrap;
    }
    body.daily-page .lang .dot {
      width: 8px;
      height: 8px;
      border-radius: 50%;
      background: var(--faint);
      flex-shrink: 0;
    }

    /* ============ 飙升榜 ============ */
    body.daily-page .board {
      border: 1px solid var(--rule);
      border-radius: 12px;
      overflow: hidden;
    }
    body.daily-page .brow {
      display: grid;
      grid-template-columns: 2.4rem minmax(0, 1fr) 7.5rem 4.5rem 9rem;
      align-items: center;
      gap: .9rem;
      padding: .6rem 1rem;
      text-decoration: none;
      border-top: 1px solid var(--rule);
      transition: background var(--dur-fast) var(--ease);
    }
    body.daily-page .brow:first-child { border-top: 0; }
    body.daily-page a.brow:hover { background: var(--code-bg); }
    body.daily-page a.brow:hover .rname { color: var(--accent); }
    body.daily-page .brow-head {
      font-family: var(--mono);
      font-size: 10.5px;
      letter-spacing: .14em;
      text-transform: uppercase;
      color: var(--faint);
      background: var(--code-bg);
      padding: .42rem 1rem;
    }
    body.daily-page .rank {
      font-family: var(--mono);
      font-size: 12px;
      font-weight: 700;
      color: var(--faint);
      background: var(--code-bg);
      border-radius: 6px;
      width: 1.5rem;
      height: 1.5rem;
      display: inline-flex;
      align-items: center;
      justify-content: center;
    }
    body.daily-page .rank-top { color: var(--accent); background: var(--accent-soft); }
    body.daily-page .b-main { min-width: 0; display: grid; gap: .1rem; }
    body.daily-page .b-main .rname {
      font-family: var(--mono);
      font-size: .88rem;
      font-weight: 600;
      color: var(--ink);
