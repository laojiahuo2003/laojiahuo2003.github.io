---
// 分类页：/cat/<folder>/，文件夹即分类。URL 只用文件名，与文章页解耦。
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PostsSidebar from '../../components/PostsSidebar.astro';
import PostList from '../../components/PostList.astro';
import { categoryLabel, groupByCategory } from '../../lib/categories';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  const groups = groupByCategory(posts);
  return [...groups.entries()].map(([cat, ps]) => ({
    params: { cat },
    props: { posts: ps },
  }));
}

const { cat } = Astro.params;
const { posts } = Astro.props;
const allPosts = await getCollection('blog');
const label = categoryLabel(cat!);
---

<Base title={`${label} · Jiahuo Lao 的手记`} description={`分类「${label}」下的全部文章`}>
  <div class="posts-layout">
    <PostsSidebar active={cat!} posts={allPosts} />
    <div class="posts-main">
      <header class="cat-header">
        <p class="eyebrow">分类</p>
        <h1>{label}</h1>
      </header>
      <PostList posts={posts} />
    </div>
  </div>
</Base>

<style>
  .cat-header { margin: 0 0 2rem; }
  .cat-header h1 {
    font-family: var(--serif);
    font-weight: 600;
    font-size: 1.7rem;
    line-height: 1.3;
    margin: 0;
    text-wrap: balance;
  }
</style>
