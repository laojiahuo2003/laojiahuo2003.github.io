---
// 日报最新一期。数据由 daily/ 生成器写入 src/data/feed.json，构建时静态渲染。
import Base from '../../layouts/Base.astro';
import Masthead from '../../components/daily/Masthead.astro';
import Pager from '../../components/daily/Pager.astro';
import Report from '../../components/daily/Report.astro';
import { fmtDate, type Feed } from '../../components/daily/utils';
import feed from '../../data/feed.json';

const data = feed as unknown as Feed;
const reports = data.reports;
if (!reports?.length) throw new Error('src/data/feed.json 无报告数据');
const report = reports[0];
const older = reports[1] ? `/daily/${reports[1].date}/` : null;
---

<Base
  title="开源日报 · Jiahuo Lao 的手记"
  description="每日 GitHub 趋势、飙升榜与新项目发现"
  bodyClass="daily-page"
>
  <Masthead slot="header" report={report} />
  <section>
    <Pager date={report.date} total={reports.length} older={older} />
    <Report report={report} />
  </section>
</Base>

<style is:global>
  /* 日报是期刊排版而非正文，比文章页宽：宽屏容纳左侧目录 + 榜单与双栏卡片 */
  body.daily-page .wrap { max-width: 74rem; }
  @media (max-width: 1100px) { body.daily-page .wrap { max-width: 60rem; } }
  @media (max-width: 900px) { body.daily-page .wrap { max-width: 42rem; } }
</style>
