---
import Base from '../layouts/Base.astro';
---

<Base title="搜索 — Jiahuo Lao 的手记" description="站内全文搜索">
  <article>
    <header class="article-header">
      <h1>搜索</h1>
    </header>
    <div class="search-box">
      <input id="search-input" type="search" placeholder="搜索笔记…" autocomplete="off" />
    </div>
    <div id="search-results" class="search-results" aria-live="polite"></div>
  </article>
</Base>

<script>
  const input = document.getElementById('search-input');
  const results = document.getElementById('search-results');

  async function run(q) {
    results.innerHTML = '';
    if (!q.trim()) return;

    try {
      // 用变量引用路径，避免 Vite 在构建期尝试打包这个运行时才生成的文件
      const PF_PATH = '/pagefind/pagefind.js';
      const pagefind = await import(PF_PATH);
      const search = await pagefind.search(q);

      if (!search.results.length) {
        results.innerHTML = '<p class="search-empty">没有找到相关笔记。</p>';
        return;
      }

      const data = await Promise.all(search.results.slice(0, 20).map((r) => r.data()));
      for (const d of data) {
        const a = document.createElement('a');
        a.className = 'search-item';
        a.href = d.url;
        const h = document.createElement('h2');
        h.textContent = (d.meta.title || '').replace(/\s*—\s*Jiahuo Lao 的手记\s*$/, '');
        const p = document.createElement('p');
        p.className = 'search-excerpt';
        p.innerHTML = d.excerpt;
        a.append(h, p);
        results.appendChild(a);
      }
    } catch {
      results.innerHTML = '<p class="search-empty">搜索暂不可用：本地开发请先运行 <code>npm run build</code> 生成索引。</p>';
    }
  }

  let timer;
  input.addEventListener('input', () => {
    clearTimeout(timer);
    timer = setTimeout(() => run(input.value), 200);
  });
  input.focus();
</script>
