---
import { getCollection, render } from 'astro:content';
import 'katex/dist/katex.min.css'; // 数学样式仅文章页需要，不进全局共享包
import Base from '../../layouts/Base.astro';
import { slugOf } from '../../lib/categories';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: slugOf(post) },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);
const toc = headings.filter((h) => h.depth >= 2 && h.depth <= 3);
const dateStr = `${post.data.pubDate.getFullYear()}-${String(post.data.pubDate.getMonth() + 1).padStart(2, '0')}-${String(post.data.pubDate.getDate()).padStart(2, '0')}`;
const fmtDate = (d: Date) => `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}-${String(d.getDate()).padStart(2, '0')}`;

// 阅读时长/字数：粗略按「中文字符 + 英文单词」估算（约 400 字/分钟）
const bodyText = (post.body ?? '')
  .replace(/```[\s\S]*?```/g, ' ')
  .replace(/[#*_>~`\[\]()!|-]/g, ' ');
const cjkChars = (bodyText.match(/[一-鿿]/g) || []).length;
const latinWords = (bodyText.match(/[A-Za-z0-9_]+/g) || []).length;
const wordCount = cjkChars + latinWords;
const readingMinutes = Math.max(1, Math.round(wordCount / 400));

// JSON-LD 结构化数据（BlogPosting），利于搜索结果富摘要
const updatedDate = post.data.updated ?? post.data.pubDate;
const siteUrl = Astro.site ?? new URL('https://laojiahuo2003.github.io');
const ldJson = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.data.title,
  description: post.data.description,
  datePublished: post.data.pubDate.toISOString(),
  dateModified: updatedDate.toISOString(),
  author: { '@type': 'Person', name: 'Jiahuo Lao', url: siteUrl.href },
  mainEntityOfPage: new URL(Astro.url.pathname, siteUrl).href,
  image: new URL('/og.png', siteUrl).href,
  keywords: post.data.tags.join(', '),
  wordCount,
};

// 相关笔记：标签 IDF 加权（稀有标签更能体现相关性），最多 3 篇
const allPosts = await getCollection('blog');
const tagFreq = new Map<string, number>();
for (const p of allPosts) for (const t of p.data.tags) tagFreq.set(t, (tagFreq.get(t) ?? 0) + 1);
const idf = (t: string) => Math.log(1 + allPosts.length / (tagFreq.get(t) ?? 1));
const related = allPosts
  .filter((p) => p.id !== post.id)
  .map((p) => {
    const shared = p.data.tags.filter((t) => post.data.tags.includes(t));
    return { post: p, score: shared.reduce((s, t) => s + idf(t), 0), n: shared.length };
  })
  .filter((x) => x.n > 0)
  .sort((a, b) => b.score - a.score || b.post.data.pubDate.valueOf() - a.post.data.pubDate.valueOf())
  .slice(0, 3)
  .map((x) => x.post);

// 无共同标签时兜底为最新文章
const hasRelated = related.length > 0;
const relatedList = hasRelated
  ? related
  : allPosts
      .filter((p) => p.id !== post.id)
      .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
      .slice(0, 3);
---

<Base title={`${post.data.title} — Jiahuo Lao 的手记`} description={post.data.description} bodyClass={toc.length >= 2 ? 'post-page' : undefined} ogType="article">
  <script type="application/ld+json" is:inline set:html={JSON.stringify(ldJson)} />
  <article>
    <header class="article-header">
      <a class="back" id="back-link" href="/">← 返回列表</a>
      {post.data.tags.length > 0 && (
        <p class="article-tags">
          {post.data.tags.map((t) => <a class="tag" href={`/tags/${t}/`}>{t}</a>)}
        </p>
      )}
      <h1>{post.data.title}</h1>
      <p class="article-meta">
        <time datetime={post.data.pubDate.toISOString().slice(0, 10)}>{dateStr}</time>
        {post.data.updated && (
          <>
            <span aria-hidden="true"> · </span>
            <span>更新于 {fmtDate(post.data.updated)}</span>
          </>
        )}
        <span aria-hidden="true"> · </span>
        <span>{readingMinutes} 分钟 · {wordCount} 字</span>
      </p>
    </header>

    <div class:list={['post-layout', { 'post-layout--flat': toc.length < 2 }]}>
      <div class="post-main">
        <div class="prose">
          <Content />
        </div>

        {relatedList.length > 0 && (
          <section class="related">
            <p class="list-head">{hasRelated ? '相关笔记' : '最新文章'}</p>
            <ul class="posts">
              {relatedList.map((p) => (
                <li class="post">
                  <time datetime={p.data.pubDate.toISOString().slice(0, 10)}>{fmtDate(p.data.pubDate)}</time>
                  <div>
                    <h2><a href={`/blog/${slugOf(p)}/`}>{p.data.title}</a></h2>
                    <p>{p.data.description}</p>
                  </div>
                </li>
              ))}
            </ul>
          </section>
        )}
      </div>

      {toc.length >= 2 && (
        <aside class="toc-aside">
          <details class="toc" open>
            <summary>目录</summary>
            <nav aria-label="目录">
              <ol class="toc-list">
                {toc.map((h) => (
                  <li class={h.depth === 3 ? 'toc-item toc-item-indent' : 'toc-item'}>
                    <a href={`#${h.slug}`}>{h.text}</a>
                  </li>
                ))}
              </ol>
            </nav>
          </details>
        </aside>
      )}
    </div>
  </article>
</Base>

<script>
  // 视图过渡（ClientRouter）换文档后重跑；window 级监听离开页面时清理
  let artCleanup: (() => void) | null = null;
  document.addEventListener('astro:before-swap', () => { artCleanup?.(); artCleanup = null; });

  document.addEventListener('astro:page-load', () => {
    // 返回链接：客户端导航不更新 document.referrer，优先用导航前记录的上一页（见 Base 布局）
    const back = document.getElementById('back-link');
    if (back) {
      let prev = '';
      try { prev = sessionStorage.getItem('lastPath') ?? ''; } catch {}
      if (prev.startsWith('/tags/')) {
        back.href = prev;
        back.textContent = '← 返回标签';
      } else if (prev.startsWith('/cat/')) {
        back.href = prev;
        back.textContent = '← 返回分类';
      } else if (document.referrer) {
        try {
          const u = new URL(document.referrer);
          if (u.pathname.startsWith('/tags/')) {
            back.href = u.pathname;
            back.textContent = '← 返回标签';
          } else if (u.pathname.startsWith('/cat/')) {
            back.href = u.pathname;
            back.textContent = '← 返回分类';
          }
        } catch {}
      }
    }

    // 移动端目录默认收起：窄屏下目录置顶且展开会把正文推出首屏
    const tocDetails = document.querySelector('.toc');
    if (tocDetails && matchMedia('(max-width: 900px)').matches) {
      tocDetails.removeAttribute('open');
    }

    // 目录滚动高亮：标记当前可见章节
    const links = Array.from(document.querySelectorAll<HTMLAnchorElement>('.toc-list a'));
    const entries: { el: Element; a: HTMLAnchorElement }[] = [];
    for (const a of links) {
      const id = decodeURIComponent(a.getAttribute('href')?.slice(1) ?? '');
      const el = document.getElementById(id);
      if (el) entries.push({ el, a });
    }
    if (!entries.length) return;

    let ticking = false;
    function update() {
      ticking = false;
      let active = entries[0].a;
      for (const { el, a } of entries) {
        if (el.getBoundingClientRect().top <= 120) active = a;
      }
      for (const { a } of entries) a.classList.toggle('active', a === active);
    }
    const ac = new AbortController();
    window.addEventListener('scroll', () => {
      if (!ticking) { ticking = true; requestAnimationFrame(update); }
    }, { passive: true, signal: ac.signal });
    artCleanup = () => ac.abort();
    update();
  });
</script>
