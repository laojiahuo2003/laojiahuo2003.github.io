---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Starmap from '../components/Starmap.astro';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
const fmt = (d: Date) =>
  `${String(d.getMonth() + 1).padStart(2, '0')}-${String(d.getDate()).padStart(2, '0')}`;
const year = posts[0]?.data.pubDate.getFullYear() ?? new Date().getFullYear();
---

<Base title="Jiahuo Lao 的手记">
  <header slot="header" class="home-header">
    <div>
      <p class="eyebrow">AI Infra · LLM · 具身智能</p>
      <h1>Jiahuo Lao 的手记</h1>
      <p class="bio">在杭州写推理引擎的人。这里记录<em>把模型跑快、跑稳</em>过程中踩过的坑，和少量坑之外的思考。</p>
    </div>
    <Starmap />
  </header>

  <p class="list-head">Post Log — {year}</p>
  <ul class="posts">
    {posts.map((post) => (
      <li class="post">
        <time datetime={post.data.pubDate.toISOString().slice(0, 10)}>{fmt(post.data.pubDate)}</time>
        <div>
          <h2>
            <a href={`/blog/${post.id}/`}>{post.data.title}</a>
            {post.data.tags.map((t) => <span class="tag">{t}</span>)}
          </h2>
          <p>{post.data.description}</p>
        </div>
      </li>
    ))}
  </ul>
</Base>
