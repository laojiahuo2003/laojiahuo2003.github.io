---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Starmap from '../components/Starmap.astro';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
const fmt = (d: Date) =>
  `${String(d.getMonth() + 1).padStart(2, '0')}-${String(d.getDate()).padStart(2, '0')}`;
const tagHref = (t: string) => `/tags/${t}/`;
// 按年分组（倒序），年份随内容自动滚动
const byYear = new Map<number, typeof posts>();
for (const post of posts) {
  const y = post.data.pubDate.getFullYear();
  if (!byYear.has(y)) byYear.set(y, []);
  byYear.get(y)!.push(post);
}
const years = [...byYear.keys()].sort((a, b) => b - a);
---

<Base title="Jiahuo Lao 的手记">
  <header slot="header" class="home-header">
    <div>
      <p class="eyebrow">AI Infra · LLM · 具身智能</p>
      <h1>Jiahuo Lao 的手记</h1>
      <p class="bio">在杭州写推理引擎的人。这里记录<em>把模型跑快、跑稳</em>过程中踩过的坑，和少量坑之外的思考。</p>
    </div>
    <Starmap />
  </header>

  {years.map((year) => (
    <section>
      <p class="list-head">Post Log — {year}</p>
      <ul class="posts">
        {byYear.get(year)!.map((post) => (
          <li class="post">
            <time datetime={post.data.pubDate.toISOString().slice(0, 10)}>{fmt(post.data.pubDate)}</time>
            <div>
              <h2>
                <a href={`/blog/${post.id}/`}>{post.data.title}</a>
                {post.data.tags.map((t) => <a class="tag" href={tagHref(t)}>{t}</a>)}
              </h2>
              <p>{post.data.description}</p>
            </div>
          </li>
        ))}
      </ul>
    </section>
  ))}
</Base>
