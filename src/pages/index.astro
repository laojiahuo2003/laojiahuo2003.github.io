---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Starmap from '../components/Starmap.astro';
import PostsSidebar from '../components/PostsSidebar.astro';
import PostList from '../components/PostList.astro';

const posts = await getCollection('blog');
---

<Base title="Jiahuo Lao 的手记" bodyClass="list-page">
  <header slot="header" class="home-header">
    <div>
      <p class="eyebrow">AI Infra · LLM · Agent · 具身智能</p>
      <h1>Jiahuo Lao 的手记</h1>
    </div>
    <Starmap />
  </header>

  <div class="posts-layout">
    <PostsSidebar active="all" posts={posts} />
    <div class="posts-main">
      <PostList posts={posts} />
    </div>
  </div>
</Base>
