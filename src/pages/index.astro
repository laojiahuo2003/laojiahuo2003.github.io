---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import PostsSidebar from '../components/PostsSidebar.astro';
import PostList from '../components/PostList.astro';

const posts = await getCollection('blog');
---

<Base title="Jiahuo Lao 的手记" bodyClass="list-page">
  <header slot="header" class="home-header">
    <p class="eyebrow">Jiahuo Lao's Notes</p>
    <h1>Jiahuo Lao 的手记</h1>
    <p class="home-sub">LLM 学习笔记与踩坑记录 — 训练、推理与对齐</p>
  </header>

  <div class="posts-layout">
    <PostsSidebar active="all" posts={posts} />
    <div class="posts-main">
      <PostList posts={posts} />
    </div>
  </div>
</Base>
