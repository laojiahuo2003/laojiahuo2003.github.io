<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="drawio" version="26.0.0">
  <diagram name="rotation">
    <mxGraphModel>
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- 标题 -->
        <mxCell id="title" value="RoPE 的几何图像：位置编码 = 旋转角度（第 i 个二维子空间）" style="text;html=1;align=left;verticalAlign=middle;fontSize=17;fontStyle=1;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="250" y="40" width="560" height="28" as="geometry" />
        </mxCell>

        <!-- 坐标轴 -->
        <mxCell id="xaxis" value="" style="endArrow=none;strokeColor=#666666;strokeWidth=1.5;html=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="250" y="370" as="sourcePoint" />
            <mxPoint x="540" y="370" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="xaxisLabel" value="维度 2i" style="text;html=1;align=center;verticalAlign=top;fontSize=13;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="455" y="378" width="90" height="18" as="geometry" />
        </mxCell>
        <mxCell id="yaxis" value="" style="endArrow=none;strokeColor=#666666;strokeWidth=1.5;html=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="300" y="430" as="sourcePoint" />
            <mxPoint x="300" y="150" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="yaxisLabel" value="维度 2i+1" style="text;html=1;align=center;verticalAlign=bottom;fontSize=13;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="212" y="128" width="90" height="18" as="geometry" />
        </mxCell>
        <mxCell id="originLabel" value="O" style="text;html=1;align=center;verticalAlign=middle;fontSize=13;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="282" y="372" width="18" height="16" as="geometry" />
        </mxCell>

        <!-- 向量：位置 m 的 Q（蓝，30°） -->
        <mxCell id="vecQ" value="" style="endArrow=blockThin;endFill=1;strokeColor=#6c8ebf;strokeWidth=3;html=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="300" y="370" as="sourcePoint" />
            <mxPoint x="439" y="290" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="vecQLabel" value="&lt;font color=&quot;#6c8ebf&quot;&gt;&lt;b&gt;q&lt;sub&gt;m&lt;/sub&gt;（位置 m 的 Q）&lt;/b&gt;&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="452" y="278" width="118" height="20" as="geometry" />
        </mxCell>

        <!-- 向量：位置 n 的 K（绿，70°） -->
        <mxCell id="vecK" value="" style="endArrow=blockThin;endFill=1;strokeColor=#82b366;strokeWidth=3;html=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="300" y="370" as="sourcePoint" />
            <mxPoint x="355" y="220" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="vecKLabel" value="&lt;font color=&quot;#82b366&quot;&gt;&lt;b&gt;k&lt;sub&gt;n&lt;/sub&gt;（位置 n 的 K）&lt;/b&gt;&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="365" y="200" width="140" height="20" as="geometry" />
        </mxCell>

        <!-- 角度弧：mθ（x 轴到 q_m，灰） -->
        <mxCell id="arcM" value="" style="curved=1;endArrow=none;strokeColor=#666666;strokeWidth=1.5;html=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="410" y="370" as="sourcePoint" />
            <mxPoint x="395" y="315" as="targetPoint" />
            <Array as="points">
              <mxPoint x="406" y="342" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="arcMLabel" value="m·θ&lt;sub&gt;i&lt;/sub&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontStyle=2;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="420" y="322" width="60" height="18" as="geometry" />
        </mxCell>

        <!-- 角度弧：nθ（x 轴到 k_n，灰） -->
        <mxCell id="arcN" value="" style="curved=1;endArrow=none;strokeColor=#666666;strokeWidth=1.5;html=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="440" y="370" as="sourcePoint" />
            <mxPoint x="348" y="238" as="targetPoint" />
            <Array as="points">
              <mxPoint x="415" y="290" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="arcNLabel" value="n·θ&lt;sub&gt;i&lt;/sub&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontStyle=2;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="420" y="250" width="56" height="18" as="geometry" />
        </mxCell>

        <!-- 角度弧：(n−m)θ（两向量之间，橙，重点） -->
        <mxCell id="arcRel" value="" style="curved=1;endArrow=none;strokeColor=#d79b00;strokeWidth=2.5;html=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="374" y="328" as="sourcePoint" />
            <mxPoint x="329" y="290" as="targetPoint" />
            <Array as="points">
              <mxPoint x="355" y="305" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="arcRelLabel" value="&lt;font color=&quot;#B45309&quot;&gt;&lt;b&gt;(n−m)·θ&lt;sub&gt;i&lt;/sub&gt;&lt;/b&gt;&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="294" y="308" width="70" height="20" as="geometry" />
        </mxCell>

        <!-- 右侧说明 -->
        <mxCell id="panelText" value="把每个注意力头的向量切成 d/2 个二维子空间（一对维度 = 一个平面）&#xa;&#xa;&lt;font color=&quot;#6c8ebf&quot;&gt;位置 m 的 Q：旋转 m·θ&lt;sub&gt;i&lt;/sub&gt;&lt;/font&gt;&#xa;&lt;font color=&quot;#82b366&quot;&gt;位置 n 的 K：旋转 n·θ&lt;sub&gt;i&lt;/sub&gt;&lt;/font&gt;&#xa;&#xa;两者的夹角 = (n−m)·θ&lt;sub&gt;i&lt;/sub&gt;，与绝对位置无关" style="text;html=1;align=left;verticalAlign=top;fontSize=14;spacing=4;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="580" y="130" width="290" height="180" as="geometry" />
        </mxCell>

        <!-- 核心公式 -->
        <mxCell id="formulaBox" value="&lt;b&gt;&lt;font style=&quot;font-size:17px&quot;&gt;⟨R&lt;sub&gt;m&lt;/sub&gt;q, R&lt;sub&gt;n&lt;/sub&gt;k⟩ = ⟨q, R&lt;sub&gt;n−m&lt;/sub&gt;k⟩&lt;/font&gt;&lt;/b&gt;&lt;font style=&quot;font-size:12px&quot;&gt;&lt;br&gt;注意力打分只依赖相对位置 n − m&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="580" y="340" width="290" height="80" as="geometry" />
        </mxCell>

        <!-- θ 的直觉 -->
        <mxCell id="thetaNote" value="&lt;font color=&quot;#666666&quot;&gt;θ&lt;sub&gt;i&lt;/sub&gt; = 10000&lt;sup&gt;−2i/d&lt;/sup&gt;：不同子空间转速不同&lt;br&gt;低维转得快（分辨相邻 token），高维转得慢（分辨长距离）&lt;br&gt;—— 像时钟的秒针、分针、时针&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;fontSize=12;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="580" y="440" width="290" height="70" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
